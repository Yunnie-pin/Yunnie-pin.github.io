---
import ThemePicker from '../components/ThemePicker.astro';
import { about } from '../data/about';
import { socials } from '../data/contact';
import { House, User, Briefcase, Code, Envelope, MapPin } from '@phosphor-icons/react';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arifin Yunianta — Backend Developer",
  description = "Personal portfolio of Arifin Yunianta, a backend developer specializing in PHP, Laravel, Python, and MySQL.",
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://yunnie-pin.github.io');
const ogImage = new URL('/assets/og-image.png', siteBase).toString();
const canonicalURL = Astro.url;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Arifin Yunianta" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:site_name"   content="Arifin Yunianta" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Arifin Yunianta",
      "jobTitle": "Backend Developer",
      "url": "https://yunnie-pin.github.io",
      "description": description,
      "image": ogImage,
      "sameAs": [
        "https://github.com/Yunnie-pin",
        "https://linkedin.com/in/arifin-yunianta",
        "https://instagram.com/yunnie_pin"
      ],
      "knowsAbout": ["PHP", "Laravel", "Python", "MySQL", "PostgreSQL", "REST API", "Git", "Docker"]
    })} />

    <!-- Anti-flash: apply saved theme before first paint -->
    <script is:inline>
      (function () {
        var T = {
          phosphor: { c: '#00FF87', d: '#00C864', r: '0,255,135'   },
          matrix:   { c: '#00FF41', d: '#00CC33', r: '0,255,65'    },
          dracula:  { c: '#50FA7B', d: '#3DC95F', r: '80,250,123'  },
          cyan:     { c: '#00E5FF', d: '#00B8CC', r: '0,229,255'   },
          lime:     { c: '#A8FF3E', d: '#86CC2F', r: '168,255,62'  },
          electric: { c: '#39FF14', d: '#2BCC0F', r: '57,255,20'   },
        };
        var key = localStorage.getItem('portfolio-theme') || 'phosphor';
        var t = T[key];
        if (t && key !== 'phosphor') {
          var s = document.documentElement.style;
          s.setProperty('--color-primary',     t.c);
          s.setProperty('--color-primary-dim', t.d);
          s.setProperty('--color-primary-rgb', t.r);
          s.setProperty('--glow-sm',    '0 0 8px  rgba(' + t.r + ', 0.15)');
          s.setProperty('--glow-md',    '0 0 16px rgba(' + t.r + ', 0.20)');
          s.setProperty('--glow-lg',    '0 0 32px rgba(' + t.r + ', 0.25)');
          s.setProperty('--glow-focus', '0 0 0 2px rgba(' + t.r + ', 0.40)');
        }
      })();
    </script>

    <!-- Google Fonts: JetBrains Mono + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Custom cursor -->
    <div id="cursor-dot"  aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <!-- CRT scan line overlay (subtle) -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <!-- Mobile overlay backdrop -->
    <div id="mobile-overlay" class="mobile-overlay" aria-hidden="true"></div>

    <!-- Mobile top bar (logo only, no hamburger) -->
    <div class="mobile-topbar">
      <a href="#hero" class="nav-logo">
        <span class="nav-logo-img" aria-hidden="true"></span>
        ~/Yunnie-pin
      </a>
    </div>

    <!-- Mobile Bottom Tab Bar -->
    <nav class="mobile-bottom-tab" aria-label="Mobile navigation">
      <a href="#hero" class="tab-item" data-tab="hero" aria-label="Home">
        <House size={20} weight="thin" aria-hidden="true" />
        <span>home</span>
      </a>
      <a href="#about" class="tab-item" data-tab="about" aria-label="About">
        <User size={20} weight="thin" aria-hidden="true" />
        <span>about</span>
      </a>
      <a href="#experience" class="tab-item" data-tab="experience" aria-label="Experience">
        <Briefcase size={20} weight="thin" aria-hidden="true" />
        <span>exp</span>
      </a>
      <a href="#projects" class="tab-item" data-tab="projects" aria-label="Projects">
        <Code size={20} weight="thin" aria-hidden="true" />
        <span>projects</span>
      </a>
      <a href="#contact" class="tab-item" data-tab="contact" aria-label="Contact">
        <Envelope size={20} weight="thin" aria-hidden="true" />
        <span>contact</span>
      </a>
    </nav>

    <!-- Sidebar (sticky on desktop, slide-in on mobile) -->
    <aside class="sidebar" id="sidebar">
      <!-- Logo -->
      <a href="#hero" class="nav-logo sidebar-logo">
        <span class="nav-logo-img" aria-hidden="true"></span>
        ~/Yunnie-pin
      </a>

      <!-- Profile Card -->
      <div class="sidebar-profile">
        <div class="sidebar-avatar">
          <img
            src={`https://avatars.githubusercontent.com/u/${about.githubId}?v=4`}
            alt={about.name}
            width="56"
            height="56"
            loading="lazy"
          />
        </div>
        <p class="sidebar-profile-name">{about.name}</p>
        <p class="sidebar-profile-role">Backend Developer</p>
        <p class="sidebar-profile-location">
          <MapPin size={12} weight="thin" aria-hidden="true" /> {about.domicile}
        </p>
        <div class="sidebar-status">
          <span class="sidebar-status-dot" aria-hidden="true"></span>
          <span>available for collab</span>
        </div>
      </div>

      <!-- Nav links -->
      <nav style="flex: 1; margin-top: 1.5rem;">
        <ul class="nav-links" id="nav-links">
          <li><a href="#about"      class="nav-link" data-section="about"     ><User      size={14} weight="thin" aria-hidden="true" />// about</a></li>
          <li><a href="#experience" class="nav-link" data-section="experience"><Briefcase size={14} weight="thin" aria-hidden="true" />// experience</a></li>
          <li><a href="#projects"   class="nav-link" data-section="projects"  ><Code      size={14} weight="thin" aria-hidden="true" />// projects</a></li>
          <li><a href="#contact"    class="nav-link" data-section="contact"   ><Envelope  size={14} weight="thin" aria-hidden="true" />// contact</a></li>
        </ul>
      </nav>

      <!-- Theme picker (inline) -->
      <div class="sidebar-theme">
        <ThemePicker sidebar />
      </div>

    
      </div>
    </aside>

    <!-- Page wrapper -->
    <div class="page-wrapper">
      <!-- Page content -->
      <main>
        <slot />
      </main>

    <!-- Custom context menu -->
    <div id="ctx-menu" class="ctx-menu font-mono" role="menu" aria-label="Context menu">
      <button class="ctx-item" data-action="copy" role="menuitem">
        <span class="ctx-item-prefix">$</span> copy
      </button>
      <div class="ctx-sep" role="separator"></div>
      <button class="ctx-item" data-action="source" role="menuitem">
        <span class="ctx-item-prefix">$</span> view-source
      </button>
      <button class="ctx-item" data-action="inspect" role="menuitem">
        <span class="ctx-item-prefix">$</span> inspect element
      </button>
      <div class="ctx-sep" role="separator"></div>
      <button class="ctx-item" data-action="contact" role="menuitem">
        <span class="ctx-item-prefix">$</span> contact me
      </button>
      <button class="ctx-item" data-action="cv" role="menuitem">
        <span class="ctx-item-prefix">↓</span> download cv
      </button>
    </div>

    <!-- Back to top -->
    <button id="back-to-top" class="back-to-top font-mono" aria-label="Back to top">[↑ top]</button>

      <!-- Footer -->
      <footer style="border-top: 1px solid var(--color-border); padding: 1.5rem; text-align: center;">
        <p class="font-mono" style="color: var(--color-fg-dim); font-size: 0.75rem;">
          <span style="color: var(--color-primary);">$</span> echo "Built with Astro by Yunnie-pin" <span style="color: var(--color-primary);">|</span>
        </p>
      </footer>
    </div><!-- /page-wrapper -->
  </body>
</html>

<script>
  // ── Scroll Progress Bar ───────────────────────────────────────────────────
  const progressBar = document.getElementById('scroll-progress');
  function updateProgress() {
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
    if (progressBar) progressBar.style.width = `${pct}%`;
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  // ── Heavy Smooth Scroll (lerp) ───────────────────────────────────────────
  if (
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    window.matchMedia('(pointer: fine)').matches
  ) {
    let targetY  = window.scrollY;
    let currentY = window.scrollY;
    const EASE   = 0.075; // lower = heavier (try 0.05–0.12)

    window.addEventListener('wheel', (e) => {
      e.preventDefault();
      const max = document.documentElement.scrollHeight - window.innerHeight;
      targetY = Math.max(0, Math.min(targetY + e.deltaY, max));
    }, { passive: false });

    // Sync when user jumps via keyboard / scrollbar / anchor links
    window.addEventListener('scroll', () => {
      const diff = Math.abs(window.scrollY - currentY);
      if (diff > 80) {
        currentY = window.scrollY;
        targetY  = window.scrollY;
      }
    }, { passive: true });

    (function loop() {
      currentY += (targetY - currentY) * EASE;
      if (Math.abs(targetY - currentY) > 0.1) {
        window.scrollTo(0, currentY);
      }
      requestAnimationFrame(loop);
    })();
  }

  // ── Scroll-Spy ────────────────────────────────────────────────────────────
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-section]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
  const tabItems = document.querySelectorAll<HTMLAnchorElement>('.tab-item[data-tab]');

  const isMobile = () => window.innerWidth < 1024;

  function getActiveId(): string {
    // Offset: topbar height on mobile, 0 on desktop + small buffer
    const offset = isMobile() ? 56 : 80;
    let current = sections[0]?.id ?? '';
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= offset) {
        current = section.id;
      }
    }
    return current;
  }

  function updateSpy() {
    const id = getActiveId();
    navLinks.forEach((l) => l.classList.toggle('active', l.dataset.section === id));
    tabItems.forEach((t) => t.classList.toggle('active', t.dataset.tab === id));
  }

  // Set initial active state on load
  updateSpy();

  let spyRaf: number | null = null;
  window.addEventListener('scroll', () => {
    if (!spyRaf) spyRaf = requestAnimationFrame(() => { updateSpy(); spyRaf = null; });
  }, { passive: true });

  // ── Hamburger / Sidebar Toggle ────────────────────────────────────────────
  const hamburger = document.getElementById('hamburger') as HTMLButtonElement | null;
  const sidebar   = document.getElementById('sidebar')   as HTMLElement | null;
  const overlay   = document.getElementById('mobile-overlay') as HTMLDivElement | null;

  function closeMenu() {
    sidebar?.classList.remove('open');
    overlay?.classList.remove('visible');
    hamburger?.classList.remove('open');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  hamburger?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.contains('open');
    if (isOpen) {
      closeMenu();
    } else {
      sidebar?.classList.add('open');
      overlay?.classList.add('visible');
      hamburger.classList.add('open');
      hamburger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  });

  overlay?.addEventListener('click', closeMenu);
  sidebar?.querySelectorAll('.nav-link').forEach((link) => {
    link.addEventListener('click', () => { if (isMobile()) closeMenu(); });
  });
  // Close sidebar when CTA links clicked on mobile
  sidebar?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => { if (isMobile()) closeMenu(); });
  });

  // ── Custom Context Menu ───────────────────────────────────────────────────
  const ctxMenu = document.getElementById('ctx-menu') as HTMLElement | null;

  function openCtx(x: number, y: number) {
    if (!ctxMenu) return;
    // Reset position first so size measurement is accurate
    ctxMenu.style.left = `${x}px`;
    ctxMenu.style.top  = `${y}px`;
    ctxMenu.classList.add('open');
    // Flip if overflowing viewport
    const { width: mw, height: mh } = ctxMenu.getBoundingClientRect();
    if (x + mw > window.innerWidth)  ctxMenu.style.left = `${x - mw}px`;
    if (y + mh > window.innerHeight) ctxMenu.style.top  = `${y - mh}px`;
  }

  function closeCtx() { ctxMenu?.classList.remove('open'); }

  document.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    // Update [copy] label based on whether text is selected
    const hasSel = (window.getSelection()?.toString().trim().length ?? 0) > 0;
    const copyBtn = ctxMenu?.querySelector<HTMLElement>('[data-action="copy"]');
    if (copyBtn) {
      copyBtn.querySelector('.ctx-item-prefix')!.textContent = hasSel ? '$' : '//';
      copyBtn.style.opacity = hasSel ? '1' : '0.4';
    }
    openCtx(e.clientX, e.clientY);
  });

  document.addEventListener('click',   (e) => { if (!ctxMenu?.contains(e.target as Node)) closeCtx(); });
  document.addEventListener('scroll',  closeCtx, { passive: true });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCtx(); });

  ctxMenu?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
    if (!btn) return;
    closeCtx();

    switch (btn.dataset.action) {
      case 'copy': {
        const sel = window.getSelection()?.toString() ?? '';
        if (sel) await navigator.clipboard.writeText(sel);
        break;
      }
      case 'source':
        window.open(`view-source:${location.href}`, '_blank');
        break;
      case 'inspect':
        console.log(
          '%c👋 Hey there, fellow developer!',
          'color:#00FF87;font-size:16px;font-weight:bold;'
        );
        console.log(
          '%cPoking around? Respect. The stack: Astro v5 + Tailwind v4 + Three.js\n%cTry typing "sudo hire me" in the hero terminal 😄',
          'color:#8B9E8B;font-size:12px;',
          'color:#00C8F0;font-size:12px;'
        );
        break;
      case 'contact':
        document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
        break;
      case 'cv':
        window.open('/assets/cv.pdf', '_blank');
        break;
    }
  });

  // ── Section Fade In / Fade Out + Stagger Children ────────────────────────
  const revealSections = document.querySelectorAll<HTMLElement>('section:not(#hero)');

  // Setup: add section-reveal class + stagger delays to children
  revealSections.forEach((section) => {
    section.classList.add('section-reveal');

    // Stagger headings
    section.querySelectorAll<HTMLElement>('.section-heading').forEach((el) => {
      el.classList.add('stagger-child');
      el.style.transitionDelay = '0ms';
    });
    section.querySelectorAll<HTMLElement>('.section-subheading').forEach((el) => {
      el.classList.add('stagger-child');
      el.style.transitionDelay = '80ms';
    });

    // Stagger grid/list items
    section.querySelectorAll<HTMLElement>('[data-stagger]').forEach((grid) => {
      Array.from(grid.children).forEach((child, i) => {
        const el = child as HTMLElement;
        el.classList.add('stagger-child');
        el.style.transitionDelay = `${180 + i * 80}ms`;
      });
    });
  });

  // Observer: fade in on enter, fade out on exit top
  const sectionObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      const el   = entry.target as HTMLElement;
      const fromTop = entry.boundingClientRect.top < 0;

      if (entry.isIntersecting) {
        el.classList.add('is-visible');
        el.classList.remove('is-exit');
      } else if (fromTop) {
        // Section scrolled past (leaving from top)
        el.classList.add('is-exit');
        el.classList.remove('is-visible');
      } else {
        // Section not yet reached (below viewport)
        el.classList.remove('is-visible', 'is-exit');
      }
    });
  }, { threshold: 0.08 });

  revealSections.forEach((s) => sectionObserver.observe(s));

  // ── Back to Top ───────────────────────────────────────────────────────────
  const backToTop = document.getElementById('back-to-top') as HTMLButtonElement | null;

  window.addEventListener('scroll', () => {
    if (backToTop) {
      backToTop.classList.toggle('visible', window.scrollY > 300);
    }
  }, { passive: true });

  backToTop?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // ── Custom Cursor ─────────────────────────────────────────────────────────
  if (window.matchMedia('(pointer: fine)').matches) {
    const dot  = document.getElementById('cursor-dot')  as HTMLElement | null;
    const ring = document.getElementById('cursor-ring') as HTMLElement | null;
    if (dot && ring) {
      let mouseX = -100, mouseY = -100;
      let ringX  = -100, ringY  = -100;

      // top/left in CSS already offsets by -half, so translate directly to cursor coords
      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
        dot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
        dot.classList.add('active');
        ring.classList.add('active');
      }, { passive: true });

      document.addEventListener('mouseleave', () => {
        dot.classList.remove('active');
        ring.classList.remove('active');
      });
      document.addEventListener('mouseenter', () => {
        dot.classList.add('active');
        ring.classList.add('active');
      });

      function animateRing() {
        ringX += (mouseX - ringX) * 0.14;
        ringY += (mouseY - ringY) * 0.14;
        ring.style.transform = `translate(${ringX}px, ${ringY}px)`;
        requestAnimationFrame(animateRing);
      }
      animateRing();

    }
  }

  // ── Proximity Glow ────────────────────────────────────────────────────────
  if (
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
    window.matchMedia('(pointer: fine)').matches
  ) {
    const RADIUS = 200; // px — glow radius
    const SELECTORS = '.nav-link, .badge, .terminal-card, .swatch-dot-btn, .social-link';

    let proxX = -9999, proxY = -9999;

    document.addEventListener('mousemove', (e) => {
      proxX = e.clientX;
      proxY = e.clientY;
    }, { passive: true });

    // Cache element list once — static site, DOM doesn't change after load
    const proximityEls = Array.from(
      document.querySelectorAll<HTMLElement>(SELECTORS)
    );

    function updateProximity() {
      // Batch: read all rects first, then write — avoids layout thrashing
      const rects = proximityEls.map(el => el.getBoundingClientRect());

      proximityEls.forEach((el, i) => {
        const rect = rects[i];
        // Skip elements entirely outside viewport
        if (rect.bottom < -80 || rect.top > window.innerHeight + 80) {
          if (el.style.getPropertyValue('--proximity') !== '0') {
            el.style.setProperty('--proximity', '0');
          }
          return;
        }
        const cx = rect.left + rect.width  / 2;
        const cy = rect.top  + rect.height / 2;
        const dist = Math.sqrt((proxX - cx) ** 2 + (proxY - cy) ** 2);
        el.style.setProperty('--proximity', Math.max(0, 1 - dist / RADIUS).toFixed(3));
      });

      requestAnimationFrame(updateProximity);
    }

    updateProximity();
  }
</script>

<style is:global>
  @import "../styles/global.css";
</style>
