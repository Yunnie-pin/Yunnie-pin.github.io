---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arifin Yunianta — Backend Developer",
  description = "Personal portfolio of Arifin Yunianta, a backend developer specializing in PHP, Laravel, Python, and MySQL.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Arifin Yunianta" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google Fonts: JetBrains Mono + Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- CRT scan line overlay (subtle) -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <!-- Navbar -->
    <nav class="navbar">
      <a href="#hero" class="nav-logo">~/arifin</a>
      <ul class="nav-links">
        <li><a href="#about"    class="nav-link">// about</a></li>
        <li><a href="#projects" class="nav-link">// projects</a></li>
        <li><a href="#contact"  class="nav-link">// contact</a></li>
      </ul>
    </nav>

    <!-- Page content -->
    <main style="padding-top: 56px;">
      <slot />
    </main>

    <!-- Footer -->
    <footer style="border-top: 1px solid var(--color-border); padding: 1.5rem; text-align: center;">
      <p class="font-mono" style="color: var(--color-fg-dim); font-size: 0.75rem;">
        <span style="color: var(--color-primary);">$</span> echo "Built with Astro + ♥ by Arifin Yunianta"
      </p>
    </footer>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
