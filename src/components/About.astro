---
import TerminalCard from './ui/TerminalCard.astro';
import Badge from './ui/Badge.astro';
import TerminalPrompt from './ui/TerminalPrompt.astro';
import { about, techStackByCategory, learningStack } from '../data/about';

---

<section id="about" class="section section-bg-void">
  <div class="container">

    <!-- Heading -->
    <p class="ascii-divider"><!-- ─────────────────────────────── --></p>
    <h2 class="section-heading glitch" data-text="// about.me">// about.me</h2>
    <p class="section-subheading">
      A little more about me, my experience, and what I'm currently learning.
    </p>

    <!-- Grid layout -->
    <div class="about-grid" data-stagger>

      <!-- Bio card -->
      <TerminalCard title="~/about/bio.md" class="bio-card">
        <div class="bio-content">

          <!-- Profile avatar -->
          <div class="profile-avatar">
            <img src={`https://avatars.githubusercontent.com/u/${about.githubId}`} alt={about.name} onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <div class="avatar-fallback">AY</div>
          </div>

          <TerminalPrompt prefix="#" command={about.name} style="margin-bottom: 1rem;" />
          <p class="bio-text">{about.bio}</p>
          <p class="bio-text-muted">
            {about.subbio}
          </p>

          <!-- Quick stats -->
          <div class="quick-stats" id="quick-stats">
            <div class="stat-item">
              <span class="stat-value phosphor font-mono" data-count-up={about.stats.years}>0</span>
              <span class="stat-label">Year Experience</span>
            </div>
            <div class="stat-item">
              <span class="stat-value phosphor font-mono" data-count-up={about.stats.projects}>0</span>
              <span class="stat-label">Project/Product</span>
            </div>
            <div class="stat-item">
              <span class="stat-value phosphor font-mono">∞</span>
              <span class="stat-label">Caffeine Consumed</span>
            </div>
          </div>
        </div>
      </TerminalCard>

      <!-- Tech stack card -->
      <TerminalCard title="~/about/tech-stack.sh" class="stack-card" id="stack-card">
        <div class="stack-content">
          <TerminalPrompt command="cat tech_stack.txt" style="margin-bottom: 1rem;" />
          <div class="stack-categories">
            {techStackByCategory.map((category) => (
              <div class="stack-category">
                <p class="font-mono category-label">// {category.label}</p>
                <div class="badges-grid">
                  {category.items.map((tech) => (
                    <Badge variant={tech.variant}>[{tech.name}]</Badge>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <div class="stack-divider">
            <p class="font-mono stack-comment">
              // Currently learning
            </p>
            <div class="stack-learning">
              {learningStack.map((tech) => (
                <Badge variant={tech.variant}>[{tech.name}]</Badge>
              ))}
            </div>
          </div>
        </div>
      </TerminalCard>

    </div>

    <!-- Neofetch + GIF row -->
    <div class="neofetch-wrap">

      <TerminalCard title="~/about/neofetch">
      <div class="nf-body">
        <TerminalPrompt command="neofetch --location" style="margin-bottom: 0.75rem;" />

        <div class="nf-layout">

          <!-- Spinning ASCII donut -->
          <pre id="nf-donut" class="nf-donut font-mono phosphor" aria-hidden="true"></pre>

          <div class="nf-info">
          <!-- ASCII identity block -->
          <div class="nf-identity">
            <p class="nf-user font-mono"><span class="phosphor">yunnie-pin</span><span class="nf-at">@</span><span class="nf-host">127.0.0.1</span></p>
            <p class="nf-sep font-mono">────────────────</p>
          </div>

          <!-- Info table -->
          <div class="nf-table">
            <div class="nf-row">
              <span class="nf-key font-mono">location</span>
              <span class="nf-val font-mono">{about.domicile}</span>
            </div>
            <div class="nf-row">
              <span class="nf-key font-mono">timezone</span>
              <span class="nf-val font-mono">{about.timezone}</span>
            </div>
            <div class="nf-row">
              <span class="nf-key font-mono">local time</span>
              <span class="nf-val font-mono phosphor" id="nf-time">--:--:--</span>
            </div>
            <div class="nf-row">
              <span class="nf-key font-mono">date</span>
              <span class="nf-val font-mono" id="nf-date">---</span>
            </div>
            <!-- <div class="nf-row">
              <span class="nf-key font-mono">uptime</span>
              <span class="nf-val font-mono">3+ years coding</span>
            </div>
            <div class="nf-row">
              <span class="nf-key font-mono">shell</span>
              <span class="nf-val font-mono">bash</span>
            </div> -->
            <div class="nf-row">
              <span class="nf-key font-mono">status</span>
              <span class="nf-val font-mono"><span class="phosphor">●</span> open to collaboration</span>
            </div>
          </div>
          </div><!-- /nf-info -->

        </div>

        <!-- Color swatches -->
        <div class="nf-swatches">
          <span class="nf-swatch" style="background: var(--color-void);"></span>
          <span class="nf-swatch" style="background: var(--color-panel);"></span>
          <span class="nf-swatch" style="background: var(--color-elevated);"></span>
          <span class="nf-swatch" style="background: var(--color-border-bright);"></span>
          <span class="nf-swatch" style="background: var(--color-primary);"></span>
          <span class="nf-swatch" style="background: var(--color-cyan);"></span>
          <span class="nf-swatch" style="background: var(--color-yellow);"></span>
          <span class="nf-swatch" style="background: var(--color-red);"></span>
        </div>

      </div>
      </TerminalCard>

      <TerminalCard title="~/about/now-playing.gif" noPadding>
        <canvas id="mari-canvas" class="gif-img"></canvas>
        <img
          id="mari-gif"
          src="/assets/mari.gif"
          alt="Blue Archive Mari"
          class="gif-img gif-hidden"
          crossorigin="anonymous"
        />
      </TerminalCard>

    </div>

  </div>
</section>

<script>
  // ── GIF freeze / unfreeze ────────────────────────────────────────────────
  const mariGif    = document.getElementById('mari-gif')    as HTMLImageElement | null;
  const mariCanvas = document.getElementById('mari-canvas') as HTMLCanvasElement | null;

  if (mariGif && mariCanvas) {
    const ctx = mariCanvas.getContext('2d');

    function freezeToCanvas() {
      if (!ctx) return;
      mariCanvas!.width  = mariGif!.naturalWidth  || 220;
      mariCanvas!.height = mariGif!.naturalHeight || 220;
      ctx.drawImage(mariGif!, 0, 0, mariCanvas!.width, mariCanvas!.height);
      mariCanvas!.style.display = 'block';
      mariGif!.style.display    = 'none';
    }

    // Capture first frame once image has loaded
    if (mariGif.complete && mariGif.naturalWidth) {
      freezeToCanvas();
    } else {
      mariGif.addEventListener('load', freezeToCanvas, { once: true });
    }

    // Hover: show animated GIF
    mariCanvas.addEventListener('mouseenter', () => {
      mariCanvas!.style.display = 'none';
      mariGif!.style.display    = 'block';
    });

    // Leave: re-freeze to canvas
    mariGif.addEventListener('mouseleave', () => {
      freezeToCanvas();
    });
  }

  // ── Tech stack badges: stagger cascade ──────────────────────────────────
  const stackCard = document.getElementById('stack-card');
  if (stackCard) {
    const badges = stackCard.querySelectorAll<HTMLElement>('.badge');
    badges.forEach((b) => { b.style.opacity = '0'; b.style.transform = 'scale(0.82)'; });

    const stackObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        stackObserver.disconnect();
        badges.forEach((badge, i) => {
          badge.style.transition = `opacity 0.28s ease-out ${i * 40}ms, transform 0.28s cubic-bezier(0.34,1.56,0.64,1) ${i * 40}ms`;
          badge.style.opacity = '1';
          badge.style.transform = 'scale(1)';
        });
      });
    }, { threshold: 0.2 });

    stackObserver.observe(stackCard);
  }

  // ── Quick stats: stagger + count-up ─────────────────────────────────────
  const statsEl = document.getElementById('quick-stats');
  if (statsEl) {
    const items = statsEl.querySelectorAll<HTMLElement>('.stat-item');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();

        items.forEach((item, i) => {
          item.style.animationDelay = `${i * 120}ms`;
          item.classList.add('stat-animate-in');

          const valueEl = item.querySelector<HTMLElement>('[data-count-up]');
          if (!valueEl) return;
          const raw = valueEl.dataset.countUp ?? '0';
          const target = parseInt(raw, 10);
          const suffix = raw.replace(String(target), '');
          if (!target) return;

          setTimeout(() => {
            const duration = 900;
            const start = performance.now();
            function tick(now: number) {
              const elapsed = now - start;
              const progress = Math.min(elapsed / duration, 1);
              // ease-out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = Math.round(eased * target);
              valueEl.textContent = current + (progress >= 1 ? suffix : '');
              if (progress < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          }, i * 120);
        });
      });
    }, { threshold: 0.4 });

    observer.observe(statsEl);
  }

  const TZ = 'Asia/Jakarta';

  function updateClock() {
    const now = new Date();
    const timeEl = document.getElementById('nf-time');
    const dateEl = document.getElementById('nf-date');
    if (timeEl) timeEl.textContent = now.toLocaleTimeString('en-GB', { timeZone: TZ, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    if (dateEl) dateEl.textContent = now.toLocaleDateString('en-GB', { timeZone: TZ, weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  }

  updateClock();
  setInterval(updateClock, 1000);

  // ── Spinning ASCII donut ──────────────────────────────────────────────────
  const donutEl = document.getElementById('nf-donut') as HTMLPreElement | null;
  const DW = 28, DH = 14;
  let A = 1.0, B = 1.0;

  function renderDonut() {
    const b: string[] = new Array(DW * DH).fill(' ');
    const z: number[] = new Array(DW * DH).fill(0);
    const sinA = Math.sin(A), cosA = Math.cos(A);
    const sinB = Math.sin(B), cosB = Math.cos(B);
    for (let j = 0; j < 6.28; j += 0.10) {
      const sinJ = Math.sin(j), cosJ = Math.cos(j);
      for (let i = 0; i < 6.28; i += 0.03) {
        const sinI = Math.sin(i), cosI = Math.cos(i);
        const h = cosJ + 2;
        const D = 1 / (sinI * h * sinA + sinJ * cosA + 5);
        const t = sinI * h * cosA - sinJ * sinA;
        const x = Math.floor(DW / 2 + (DW / 2 - 1) * D * (cosI * h * cosB - t * sinB));
        const y = Math.floor(DH / 2 + (DH / 2 - 1) * 0.85 * D * (cosI * h * sinB + t * cosB));
        const o = x + DW * y;
        const N = Math.floor(8 * ((sinJ * sinA - sinI * cosJ * cosA) * cosB - sinI * cosJ * sinA - sinJ * cosA - cosI * cosJ * sinB));
        if (y >= 0 && y < DH && x >= 0 && x < DW && D > z[o]) {
          z[o] = D;
          b[o] = '.,-~:;=!*#$@'[N > 0 ? N : 0];
        }
      }
    }
    if (donutEl) {
      let out = '';
      for (let i = 0; i < DH; i++) out += b.slice(i * DW, (i + 1) * DW).join('') + '\n';
      donutEl.textContent = out;
    }
    A += 0.07;
    B += 0.03;
  }

  renderDonut();
  setInterval(renderDonut, 50);
</script>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .quick-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    opacity: 0;
    transform: translateY(10px);
  }
  @keyframes stat-in {
    to { opacity: 1; transform: translateY(0); }
  }
  .stat-item.stat-animate-in {
    animation: stat-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .stat-label {
    font-size: 0.72rem;
    color: var(--color-fg-muted);
  }

  @keyframes phosphor-pulse {
    0%, 100% {
      box-shadow:
        0 0 0 2px var(--color-primary),
        0 0 8px 2px color-mix(in srgb, var(--color-primary) 40%, transparent),
        0 0 18px 4px color-mix(in srgb, var(--color-primary) 20%, transparent);
      border-color: var(--color-primary);
    }
    50% {
      box-shadow:
        0 0 0 2px color-mix(in srgb, var(--color-primary) 60%, transparent),
        0 0 14px 4px color-mix(in srgb, var(--color-primary) 55%, transparent),
        0 0 32px 8px color-mix(in srgb, var(--color-primary) 25%, transparent);
      border-color: color-mix(in srgb, var(--color-primary) 70%, transparent);
    }
  }

  .profile-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 2px solid var(--color-primary);
    overflow: hidden;
    margin-bottom: 1.25rem;
    position: relative;
    flex-shrink: 0;
    animation: phosphor-pulse 2.8s ease-in-out infinite;
  }
  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .avatar-fallback {
    display: none; /* toggled via onerror */
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: var(--color-elevated);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.05em;
  }

  .stack-categories {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .stack-category {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .category-label {
    font-size: 0.7rem;
    color: var(--color-fg-dim);
  }
  .badges-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* Badge hover: lift + glow */
  .stack-card :global(.badge) {
    cursor: default;
    transition: transform 0.18s ease-out, box-shadow 0.18s ease-out, filter 0.18s ease-out;
  }
  .stack-card :global(.badge:hover) {
    transform: translateY(-2px) scale(1.06);
    filter: brightness(1.25);
    box-shadow: 0 4px 14px rgba(0, 255, 135, 0.18);
  }

  .bio-text {
    color: var(--color-fg);
    line-height: 1.8;
    margin-bottom: 1rem;
  }
  .bio-text-muted {
    color: var(--color-fg-muted);
    line-height: 1.8;
  }
  .stack-divider {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .stack-comment {
    font-size: 0.75rem;
    color: var(--color-fg-dim);
    margin-bottom: 0.5rem;
  }
  .stack-learning {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  /* ── Neofetch + GIF row ── */
  .neofetch-wrap {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .neofetch-wrap {
      grid-template-columns: 1fr auto;
      align-items: stretch;
    }
  }

  .gif-img {
    display: block;
    width: 100%;
    max-width: 220px;
    height: auto;
    margin: 0 auto;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    cursor: pointer;
  }
  .gif-hidden {
    display: none;
  }
  #mari-canvas {
    filter: grayscale(1) brightness(0.75);
    transition: filter 0.35s ease;
  }
  #mari-gif {
    display: none;
  }

  .nf-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nf-layout {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  @media (min-width: 560px) {
    .nf-layout {
      flex-direction: row;
      gap: 1.75rem;
      align-items: flex-start;
    }
  }

  .nf-donut {
    font-size: 0.6rem;
    line-height: 1.15;
    letter-spacing: 0.04em;
    flex-shrink: 0;
    user-select: none;
    white-space: pre;
  }

  .nf-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .nf-identity {
    flex-shrink: 0;
  }
  .nf-user {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .nf-at   { color: var(--color-fg-dim); }
  .nf-host { color: var(--color-cyan); }
  .nf-sep  {
    font-size: 0.72rem;
    color: var(--color-border-bright);
    margin-top: 2px;
  }

  .nf-table {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  .nf-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .nf-key {
    font-size: 0.72rem;
    color: var(--color-primary);
    min-width: 90px;
    flex-shrink: 0;
  }

  .nf-val {
    font-size: 0.78rem;
    color: var(--color-fg-muted);
  }

  /* Color swatches (neofetch terminal palette) */
  .nf-swatches {
    display: flex;
    gap: 5px;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nf-swatch {
    width: 16px;
    height: 16px;
    border-radius: 3px;
    border: 1px solid var(--color-border);
    flex-shrink: 0;
  }

</style>
