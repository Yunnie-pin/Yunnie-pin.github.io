  .ide-file-star { color: var(--color-yellow); font-size: 0.58rem; flex-shrink: 0; }

  /* ── Editor ──────────────────────────────────────────────────────────────── */
  .ide-editor { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; min-height: 0; }

  /* Tab bar */
  .ide-tab-bar {
    display: flex;
