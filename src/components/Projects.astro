    z-index: 10001 !important;
    animation: ide-expand 0.28s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  /* ── Scan-in animation (preview) ─────────────────────────────────────────── */
  @keyframes ide-scan {
    from { opacity: 0; clip-path: inset(0 0 100% 0); }
