  .ide-boot.active { opacity: 1; pointer-events: all; }
  .ide-boot-line {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-6px);
    animation: boot-line-in 0.2s ease-out forwards;
  }
  @keyframes boot-line-in {
    to { opacity: 1; transform: translateX(0); }
  }

  /* ── Dot interactions ────────────────────────────────────────────────────── */
  .ide-dot {
    cursor: pointer;
    transition: transform 0.15s ease-out, filter 0.15s;
  }
  .ide-dot:hover  { transform: scale(1.25); filter: brightness(1.3); }
  .ide-dot:active { transform: scale(0.9); }

  /* ── Dragging state ──────────────────────────────────────────────────────── */
  .ide-window.is-dragging {
    cursor: grabbing;
