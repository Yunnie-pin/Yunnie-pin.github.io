  .ide-window.is-dragging .ide-titlebar { cursor: grabbing; }
  #ide-titlebar { cursor: grab; user-select: none; }

  /* ── Fullscreen mode ─────────────────────────────────────────────────────── */
  .ide-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.72);
    z-index: 10000;
    opacity: 0;
    transition: opacity 0.2s ease-out;
  }
  .ide-overlay.active { opacity: 1; }

  @keyframes ide-expand {
    from { transform: translate(-50%,-50%) scale(0.9); opacity: 0; }
    to   { transform: translate(-50%,-50%) scale(1);   opacity: 1; }
  }
  @keyframes ide-collapse {
    from { transform: translate(-50%,-50%) scale(1);   opacity: 1; }
    to   { transform: translate(-50%,-50%) scale(0.9); opacity: 0; }
  }
  .ide-window.ide-fullscreen {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    transform: translate(-50%, -50%) !important;
