---
import TerminalCard from './ui/TerminalCard.astro';
import Badge from './ui/Badge.astro';

interface Project {
  title: string;
  description: string;
  tech: string[];
  url?: string;
  repo?: string;
  status: 'live' | 'wip' | 'archived';
  featured?: boolean;
}

const projects: Project[] = [
  {
    title: "Project Title 1",
    description: "Deskripsi singkat proyek ini. Ceritakan apa yang dibangun, masalah yang diselesaikan, dan teknologi utama yang digunakan.",
    tech: ["PHP", "Laravel", "MySQL"],
    url: "#",
    repo: "#",
    status: "live",
    featured: true,
  },
  {
    title: "Project Title 2",
    description: "Deskripsi singkat proyek ini. REST API backend untuk aplikasi mobile dengan autentikasi JWT dan manajemen role.",
    tech: ["Laravel", "PostgreSQL", "REST API"],
    url: "#",
    repo: "#",
    status: "live",
  },
  {
    title: "Project Title 3",
    description: "Deskripsi singkat proyek ini. Script automasi data dengan Python untuk kebutuhan reporting dan analitik.",
    tech: ["Python", "MySQL", "Pandas"],
    repo: "#",
    status: "wip",
  },
  {
    title: "Project Title 4",
    description: "Deskripsi singkat proyek ini. Tambahkan detail proyek Anda di sini.",
    tech: ["PHP", "Bootstrap", "JavaScript"],
    url: "#",
    status: "archived",
  },
];

const statusLabel: Record<Project['status'], string> = {
  live:     '[LIVE]',
  wip:      '[WIP]',
  archived: '[ARCHIVED]',
};
const statusColor: Record<Project['status'], string> = {
  live:     'var(--color-primary)',
  wip:      'var(--color-yellow)',
  archived: 'var(--color-fg-dim)',
};

// Collect unique tech tags for filter
const allTechs = [...new Set(projects.flatMap((p) => p.tech))].sort();
---

<section id="projects" class="section" style="background: var(--color-void);">
  <div class="container">

    <!-- Heading -->
    <p class="ascii-divider"><!-- ─────────────────────────────── --></p>
    <h2 class="section-heading glitch" data-text="// projects">// projects</h2>
    <p class="section-subheading">Beberapa proyek yang pernah saya kerjakan</p>

    <!-- Filter bar -->
    <div class="filter-bar" id="filter-bar">
      <button class="filter-btn active" data-filter="all">[ALL]</button>
      <button class="filter-btn" data-filter="status:live">[LIVE]</button>
      <button class="filter-btn" data-filter="status:wip">[WIP]</button>
      <button class="filter-btn" data-filter="status:archived">[ARCHIVED]</button>
      {allTechs.map((tech) => (
        <button class="filter-btn" data-filter={`tech:${tech}`}>[{tech}]</button>
      ))}
    </div>

    <!-- Bento grid -->
    <div class="projects-grid" id="projects-grid">
      {projects.map((project) => (
        <div
          class={`project-item ${project.featured ? 'featured' : ''}`}
          data-status={project.status}
          data-tech={project.tech.join(',')}
        >
          <TerminalCard title={`~/projects/${project.title.toLowerCase().replace(/ /g, '-')}`} class="h-full">
            <div class="project-body">

              <!-- Header -->
              <div class="project-header">
                <h3 class="project-title font-mono">{project.title}</h3>
                <span
                  class="font-mono"
                  style={`font-size: 0.7rem; color: ${statusColor[project.status]};`}
                >
                  {statusLabel[project.status]}
                </span>
              </div>

              <!-- Description -->
              <p class="project-desc">{project.description}</p>

              <!-- Tech badges -->
              <div class="project-tech">
                {project.tech.map((t) => (
                  <Badge variant="primary">[{t}]</Badge>
                ))}
              </div>

              <!-- Links -->
              <div class="project-links">
                {project.url && project.url !== '#' ? (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link font-mono">
                    [view →]
                  </a>
                ) : project.url === '#' ? (
                  <span class="project-link font-mono" style="opacity: 0.4; cursor: default;">[view →]</span>
                ) : null}
                {project.repo && (
                  <a
                    href={project.repo !== '#' ? project.repo : undefined}
                    target={project.repo !== '#' ? '_blank' : undefined}
                    rel="noopener noreferrer"
                    class="project-link font-mono"
                    style={project.repo === '#' ? 'opacity:0.4; cursor:default;' : ''}
                  >
                    [repo →]
                  </a>
                )}
              </div>

            </div>
          </TerminalCard>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div style="text-align: center; margin-top: 2rem;">
      <p class="font-mono" style="color: var(--color-fg-muted); font-size: 0.8rem;">
        <span style="color: var(--color-primary);">$</span> git log --oneline --all
        <span style="color: var(--color-fg-dim);"> # more on GitHub</span>
      </p>
    </div>

  </div>
</section>

<script>
  // ── On-scroll Reveal ───────────────────────────────────────────────────────
  const items = document.querySelectorAll<HTMLElement>('.project-item');

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  items.forEach((item) => revealObserver.observe(item));

  // ── Filter ─────────────────────────────────────────────────────────────────
  const filterBar = document.getElementById('filter-bar');
  const allItems = Array.from(document.querySelectorAll<HTMLElement>('.project-item'));

  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;

    // Update active button
    filterBar.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
    btn.classList.add('active');

    const filter = btn.dataset.filter ?? 'all';

    allItems.forEach((item) => {
      const status = item.dataset.status ?? '';
      const techs  = (item.dataset.tech ?? '').split(',');

      let show = true;
      if (filter === 'all') {
        show = true;
      } else if (filter.startsWith('status:')) {
        show = status === filter.replace('status:', '');
      } else if (filter.startsWith('tech:')) {
        show = techs.includes(filter.replace('tech:', ''));
      }

      item.style.display = show ? '' : 'none';

      // Re-trigger reveal animation for newly shown items
      if (show && !item.classList.contains('visible')) {
        item.classList.add('visible');
      }
    });
  });
</script>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .project-item.featured {
      grid-column: span 2;
    }
  }

  /* On-scroll animation states (overrides global) */
  .project-item {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }
  .project-item.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .project-item:nth-child(2) { transition-delay: 75ms;  }
  .project-item:nth-child(3) { transition-delay: 150ms; }
  .project-item:nth-child(4) { transition-delay: 225ms; }

  .h-full { height: 100%; }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
  }

  .project-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .project-desc {
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    line-height: 1.7;
    flex: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .project-links {
    display: flex;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .project-link {
    font-size: 0.78rem;
    color: var(--color-primary);
    text-decoration: none;
    transition: var(--transition);
  }
  .project-link:hover {
    text-shadow: 0 0 8px rgba(0, 255, 135, 0.50);
  }
</style>
