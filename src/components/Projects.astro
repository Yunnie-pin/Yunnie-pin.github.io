  .ide-folder-files { max-height: 0; overflow: hidden; transition: max-height 0.22s ease-out; }
  .ide-folder-files.open { max-height: 400px; }

  /* ── File item ───────────────────────────────────────────────────────────── */
  .ide-file {
    display: flex;
