    transition: box-shadow 0.3s ease-out, border-color 0.3s ease-out;
  }
  .ide-window:not(.is-dragging):not(.ide-fullscreen):hover {
    border-color: rgba(var(--color-primary-rgb), 0.28);
    box-shadow: var(--shadow-lg), 0 0 32px rgba(var(--color-primary-rgb), 0.1), 0 0 64px rgba(var(--color-primary-rgb), 0.05);
  }

  /* ── Boot overlay ───────────────────────────────────────────────────────────*/
  .ide-boot {
    position: absolute;
    inset: 0;
    background: var(--color-void);
