  .ide-tab:hover { background: var(--color-elevated); color: var(--color-fg-muted); }
  .ide-tab.active {
    background: var(--color-panel);
    color: var(--color-fg);
  }
  /* Active indicator line at top */
  .ide-tab.active::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
