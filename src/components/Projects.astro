  }
  .ide-preview.ide-scan { animation: ide-scan 0.3s ease-out forwards; }

  /* ── Status flash ────────────────────────────────────────────────────────── */
  .ide-status-flash { color: var(--color-primary) !important; }

  /* ── Titlebar ─────────────────────────────────────────────────────────────── */
  .ide-titlebar {
