---
import TerminalPrompt from './ui/TerminalPrompt.astro';
import { getCollection } from 'astro:content';

const MD_COLOR = '#519aba';

// Load and sort: featured first, then live → wip → archived → internal
const STATUS_ORDER = { live: 0, wip: 1, archived: 2, internal: 3};
const entries = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return  1;
  return STATUS_ORDER[a.data.status] - STATUS_ORDER[b.data.status];
});

const grouped = {
  live:     entries.filter(e => e.data.status === 'live'),
  wip:      entries.filter(e => e.data.status === 'wip'),
  archived: entries.filter(e => e.data.status === 'archived'),
  internal: entries.filter(e => e.data.status === 'internal'),
};

// Pre-render markdown → HTML for each entry
const rendered = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    return { id: entry.id, Content, body: entry.body, data: entry.data };
  })
);

const defaultId = rendered.find(r => r.data.featured)?.id ?? rendered[0]?.id ?? '';
---

<section id="projects" class="section">
  <div class="container">

    <h2 class="section-tab-header">
      <span class="section-tab-label glitch" data-text="[•] projects" data-section="projects">[•] projects</span>
    </h2>
    <p class="section-subheading">These are some of the projects I've worked on</p>

    <!-- ── IDE Window ──────────────────────────────────────────────────────── -->
    <div class="ide-window" id="ide-window">

      <!-- Boot overlay -->
      <div class="ide-boot" id="ide-boot" aria-hidden="true">
        <div class="ide-boot-lines" id="ide-boot-lines"></div>
      </div>

      <!-- Titlebar -->
      <div class="ide-titlebar" id="ide-titlebar">
        <div class="ide-dots">
          <span class="ide-dot ide-dot-red"   id="ide-dot-red"   style="background:#FF5F57" title="Toggle Explorer" role="button" tabindex="0"></span>
          <span class="ide-dot ide-dot-yellow" id="ide-dot-yellow" style="background:#FEBC2E" title="Toggle Preview/Source" role="button" tabindex="0"></span>
          <span class="ide-dot ide-dot-green"  id="ide-dot-green"  style="background:#28C840" title="Fullscreen" role="button" tabindex="0"></span>
        </div>
        <span class="ide-title-text">~/projects — arifin@portfolio</span>
        <button class="ide-toggle-btn" id="ide-sidebar-toggle" title="Toggle Explorer" aria-label="Toggle Explorer">
          <svg width="14" height="11" viewBox="0 0 14 11" fill="none" aria-hidden="true">
            <rect x="0" y="0"   width="14" height="1.5" rx="0.75" fill="currentColor"/>
            <rect x="0" y="4.5" width="14" height="1.5" rx="0.75" fill="currentColor"/>
            <rect x="0" y="9"   width="14" height="1.5" rx="0.75" fill="currentColor"/>
          </svg>
        </button>
      </div>

      <!-- Body -->
      <div class="ide-body">

        <!-- ── Sidebar ───────────────────────────────────────────────────── -->
        <aside class="ide-sidebar" id="ide-sidebar" aria-label="Explorer">
          <div class="ide-sidebar-header">
            <span class="ide-sidebar-label">EXPLORER</span>
            <span class="ide-sidebar-count">{entries.length} files</span>
          </div>
          <div class="ide-sidebar-root">
            <span class="ide-root-label">
              <svg class="ide-chevron-root" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                <path d="M2 2l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
              PORTFOLIO
            </span>
          </div>
          <div class="ide-file-tree">
            {(Object.entries(grouped) as [string, typeof entries][])
              .filter(([, ps]) => ps.length > 0)
              .map(([status, ps]) => (
                <div class="ide-folder">
                  <button class="ide-folder-btn" data-folder={status} aria-expanded="true">
                    <svg class="ide-chevron" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M2 2l4 3-4 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                    <svg width="13" height="13" viewBox="0 0 20 20" fill="currentColor" class="ide-folder-icon" aria-hidden="true">
                      <path d="M2 6a2 2 0 012-2h4l2 2h6a2 2 0 012 2v7a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
                    </svg>
                    <span class="ide-folder-name">{status}</span>
                    <span class="ide-folder-badge">{ps.length}</span>
                  </button>
                  <div class="ide-folder-files open">
                    {ps.map(e => (
                      <button class="ide-file" data-id={e.id} aria-selected="false">
                        <span class="ide-file-dot" style={`background:${MD_COLOR}`}></span>
                        <span class="ide-file-name">{e.id}</span>
                        {e.data.featured && <span class="ide-file-star" aria-label="featured">★</span>}
                      </button>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </aside>

        <!-- ── Editor ────────────────────────────────────────────────────── -->
        <div class="ide-editor">

          <!-- Tab bar (desktop) -->
          <div class="ide-tab-bar" id="ide-tab-bar" role="tablist">
            <div class="ide-tab-empty" id="ide-tab-empty">// no file open</div>
          </div>

          <!-- Tab dropdown (mobile) -->
          <div class="ide-tab-dropdown-wrap" id="ide-tab-dropdown-wrap">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>
            </svg>
            <select class="ide-tab-dropdown" id="ide-tab-dropdown" aria-label="Open project">
              <option value="">// no file open</option>
            </select>
            <svg class="ide-dropdown-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
              <path d="M2 3l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>

          <!-- Breadcrumb + view toggle -->
          <div class="ide-breadcrumb">
            <div class="ide-bc-path">
              <span class="ide-bc">~/projects</span>
              <span class="ide-bc-sep" aria-hidden="true">›</span>
              <span class="ide-bc ide-bc-active" id="ide-bc-status">—</span>
              <span class="ide-bc-sep" aria-hidden="true">›</span>
              <span class="ide-bc ide-bc-file" id="ide-bc-file">—</span>
            </div>
            <div class="ide-view-toggle" id="ide-view-toggle" role="group" aria-label="View mode">
              <button class="ide-view-btn active" data-mode="preview" title="Markdown Preview">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                Preview
              </button>
              <button class="ide-view-btn" data-mode="source" title="Markdown Source">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
                Source
              </button>
            </div>
          </div>

          <!-- Editor content -->
          <div class="ide-content" id="ide-content">

            <!-- Welcome screen -->
            <div class="ide-welcome" id="ide-welcome">
              <p class="ide-welcome-cmd">// start</p>
              <p class="ide-welcome-hint">Select a file from the Explorer to view project details.</p>
            </div>

            <!-- Preview panel -->
            <div class="ide-preview hidden" id="ide-preview"></div>

            <!-- Source panel -->
            <div class="ide-source-view hidden" id="ide-source-view">
              <div class="ide-line-nums" id="ide-line-nums" aria-hidden="true"></div>
              <pre class="ide-source-code" id="ide-source-code"></pre>
            </div>

          </div>

          <!-- Action links -->
          <div class="ide-actions hidden" id="ide-actions">
            <a class="ide-action hidden" id="ide-action-view" target="_blank" rel="noopener noreferrer">[view →]</a>
            <a class="ide-action hidden" id="ide-action-repo" target="_blank" rel="noopener noreferrer">[repo →]</a>
            <span class="ide-action-placeholder hidden" id="ide-action-placeholder">// no external links</span>
          </div>

        </div>
      </div>

      <!-- Status bar -->
      <div class="ide-statusbar">
        <div class="ide-status-l">
          <span class="ide-status-branch">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="6" r="3"/>
              <path d="M6 9v6M18 9a9 9 0 01-9 9"/>
            </svg>
            main
          </span>
          <span class="ide-status-file">
            <span class="ide-status-dot" id="ide-status-dot">●</span>
            <span id="ide-status-text">no file open</span>
          </span>
        </div>
        <div class="ide-status-r">
          <span id="ide-status-tech"></span>
          <span class="ide-status-sep" aria-hidden="true">|</span>
          <span id="ide-status-ln">Markdown</span>
          <span class="ide-status-sep" aria-hidden="true">|</span>
          <span>UTF-8</span>
        </div>
      </div>

    </div><!-- end .ide-window -->

    <!-- Pre-rendered project data (hidden, read by JS) -->
    <div hidden aria-hidden="true" id="ide-project-store">
      {rendered.map(r => (
        <div
          class="ide-proj-entry"
          data-id={r.id}
          data-title={r.data.title}
          data-status={r.data.status}
          data-tech={r.data.tech.join(',')}
          data-url={r.data.url ?? ''}
          data-repo={r.data.repo ?? ''}
          data-featured={r.data.featured ? 'true' : 'false'}
          data-body={r.body}
        >
          <r.Content />
        </div>
      ))}
    </div>

    <div class="cta-wrap">
      <TerminalPrompt command="git log --oneline --all" comment="more on GitHub" />
    </div>

  </div>
</section>

<script define:vars={{ defaultId }} is:inline>
  // ── State ──────────────────────────────────────────────────────────────────
  let openTabs    = [];
  let activeId    = null;
  let viewMode    = 'preview';
  let isFullscreen = false;
  let focusedFileIdx = -1; // keyboard nav index in flat file list

  // ── DOM ────────────────────────────────────────────────────────────────────
  const ideWindow     = document.getElementById('ide-window');
  const ideContent    = document.getElementById('ide-content');
  const tabBar        = document.getElementById('ide-tab-bar');
  const tabEmpty      = document.getElementById('ide-tab-empty');
  const tabDropdown   = document.getElementById('ide-tab-dropdown');
  const welcome       = document.getElementById('ide-welcome');
  const preview       = document.getElementById('ide-preview');
  const sourceView    = document.getElementById('ide-source-view');
  const lineNums      = document.getElementById('ide-line-nums');
  const sourceCode    = document.getElementById('ide-source-code');
  const actions       = document.getElementById('ide-actions');
  const actionView    = document.getElementById('ide-action-view');
  const actionRepo    = document.getElementById('ide-action-repo');
  const actionHolder  = document.getElementById('ide-action-placeholder');
  const bcStatus      = document.getElementById('ide-bc-status');
  const bcFile        = document.getElementById('ide-bc-file');
  const statusDot     = document.getElementById('ide-status-dot');
  const statusText    = document.getElementById('ide-status-text');
  const statusTech    = document.getElementById('ide-status-tech');
  const statusLn      = document.getElementById('ide-status-ln');
  const sidebar       = document.getElementById('ide-sidebar');
  const viewToggle    = document.getElementById('ide-view-toggle');
  const store         = document.getElementById('ide-project-store');
  const bootEl        = document.getElementById('ide-boot');
  const bootLines     = document.getElementById('ide-boot-lines');

  // ── Helpers ────────────────────────────────────────────────────────────────
  const getEntry   = id => store?.querySelector(`[data-id="${id}"]`);
  const getAllFiles = () => Array.from(document.querySelectorAll('.ide-file'));

  function showPanel(mode) {
    preview.classList.toggle('hidden',    mode !== 'preview');
    sourceView.classList.toggle('hidden', mode !== 'source');
    viewToggle?.querySelectorAll('.ide-view-btn').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.mode === mode);
    });
  }

  // ── Status flash ───────────────────────────────────────────────────────────
  let flashTimer = null;
  function flashStatus(msg, durationMs = 1200) {
    if (flashTimer) clearTimeout(flashTimer);
    const prev = statusText.textContent;
    statusText.textContent = msg;
    statusText.classList.add('ide-status-flash');
    flashTimer = setTimeout(() => {
      statusText.classList.remove('ide-status-flash');
      if (activeId) updateStatusBar(activeId);
      else statusText.textContent = prev;
    }, durationMs);
  }

  // ── Boot sequence ──────────────────────────────────────────────────────────
  function runBoot(onDone) {
    const allFiles = getAllFiles();
    const msgs = [
      '$ initializing workspace...',
      `$ loading ${allFiles.length} project files...`,
      `$ opening ${defaultId || 'workspace'}`,
    ];
    bootEl.classList.add('active');
    let i = 0;
    function next() {
      if (i >= msgs.length) {
        setTimeout(() => {
          bootEl.classList.remove('active');
          onDone();
        }, 300);
        return;
      }
      const line = document.createElement('div');
      line.className = 'ide-boot-line';
      line.textContent = msgs[i++];
      bootLines.appendChild(line);
      setTimeout(next, 380);
    }
    next();
  }

  // ── Tab render ─────────────────────────────────────────────────────────────
  function renderTabs() {
    tabBar.querySelectorAll('.ide-tab').forEach(t => t.remove());
    tabDropdown.innerHTML = openTabs.length === 0
      ? '<option value="">// no file open</option>'
      : openTabs.map(id => `<option value="${id}" ${id === activeId ? 'selected' : ''}>${id}</option>`).join('');

    if (openTabs.length === 0) { tabEmpty.classList.remove('hidden'); return; }
    tabEmpty.classList.add('hidden');

    openTabs.forEach(id => {
      const isActive = id === activeId;
      const tab = document.createElement('button');
      tab.className = `ide-tab${isActive ? ' active' : ''}`;
      tab.dataset.id = id;
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-selected', String(isActive));
      tab.innerHTML = `
        <span class="ide-tab-dot" style="background:#519aba" aria-hidden="true"></span>
        <span class="ide-tab-name">${id}</span>
        <span class="ide-tab-close" aria-label="close ${id}">×</span>
      `;
      tab.addEventListener('click', e => {
        if (e.target.closest('.ide-tab-close')) closeTab(id, e);
        else openProject(id);
      });
      tabBar.insertBefore(tab, tabEmpty);
    });
  }

  // ── Open / close ───────────────────────────────────────────────────────────
  function openProject(id) {
    const isNew = !openTabs.includes(id);
    if (isNew) openTabs.push(id);
    activeId = id;
    renderTabs();
    renderEditor(id);
    setExplorerActive(id);
    updateStatusBar(id);
    if (isNew) flashStatus(`// opening ${id}...`, 900);
  }

  function closeTab(id, e) {
    e?.stopPropagation();
    const idx  = openTabs.indexOf(id);
    openTabs   = openTabs.filter(t => t !== id);
    flashStatus('// tab closed', 700);
    if (activeId === id) {
      openTabs.length > 0
        ? openProject(openTabs[Math.min(idx, openTabs.length - 1)])
        : showWelcome();
    } else {
      renderTabs();
    }
  }

  // ── Render editor with scan animation ─────────────────────────────────────
  function renderEditor(id) {
    const entry = getEntry(id);
    if (!entry) return;

    welcome.classList.add('hidden');
    actions.classList.remove('hidden');
    showPanel(viewMode);

    // Preview with scan-in animation
    const clone = entry.cloneNode(true);
    preview.innerHTML = '';
    preview.classList.remove('ide-scan');
    preview.appendChild(clone);
    requestAnimationFrame(() => preview.classList.add('ide-scan'));

    // Source
    const body  = entry.dataset.body ?? '';
    const lines = body.split('\n');
    lineNums.innerHTML     = lines.map((_, i) => `<span>${i + 1}</span>`).join('');
    sourceCode.textContent = body;

    // Breadcrumb + meta
    bcStatus.textContent = entry.dataset.status ?? '';
    bcFile.textContent   = id;
    statusLn.textContent = `${lines.length} lines`;

    // Actions
    const url  = entry.dataset.url  ?? '';
    const repo = entry.dataset.repo ?? '';
    const hasView = url  && url  !== '#';
    const hasRepo = repo && repo !== '#';
    actionView.classList.toggle('hidden', !hasView);
    actionRepo.classList.toggle('hidden', !hasRepo);
    actionHolder.classList.toggle('hidden', hasView || hasRepo);
    if (hasView) actionView.href = url;
    if (hasRepo) actionRepo.href = repo;

    // Sync keyboard focus index
    focusedFileIdx = getAllFiles().findIndex(f => f.dataset.id === id);
  }

  function showWelcome() {
    activeId = null;
    renderTabs();
    welcome.classList.remove('hidden');
    preview.classList.add('hidden');
    sourceView.classList.add('hidden');
    actions.classList.add('hidden');
    bcStatus.textContent  = '—';
    bcFile.textContent    = '—';
    statusDot.style.color = 'var(--color-fg-dim)';
    statusText.textContent = 'no file open';
    statusTech.textContent = '';
    statusLn.textContent  = 'Markdown';
    setExplorerActive(null);
    focusedFileIdx = -1;
  }

  // ── Explorer active state ──────────────────────────────────────────────────
  function setExplorerActive(id) {
    getAllFiles().forEach((el, i) => {
      const active = el.dataset.id === id;
      el.classList.toggle('active', active);
      el.setAttribute('aria-selected', String(active));
      if (active) focusedFileIdx = i;
    });
  }

  // ── Status bar ─────────────────────────────────────────────────────────────
  function updateStatusBar(id) {
    const entry = getEntry(id);
    if (!entry) return;
    const colors = { live: 'var(--color-primary)', wip: 'var(--color-yellow)', internal: 'var(--color-cyan)', archived: 'var(--color-fg-dim)' };
    const status = entry.dataset.status ?? '';
    statusDot.style.color  = colors[status] ?? 'var(--color-fg-dim)';
    statusText.textContent = `${status.toUpperCase()} · ${id}`;
    statusTech.textContent = (entry.dataset.tech ?? '').split(',')[0] ?? '';
  }

  // ── Window dots ────────────────────────────────────────────────────────────
  // Red: toggle sidebar
  document.getElementById('ide-dot-red')?.addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
    flashStatus(sidebar.classList.contains('collapsed') ? '// explorer hidden' : '// explorer shown', 800);
  });

  // Yellow: toggle preview ↔ source
  document.getElementById('ide-dot-yellow')?.addEventListener('click', () => {
    if (!activeId) return;
    viewMode = viewMode === 'preview' ? 'source' : 'preview';
    showPanel(viewMode);
    renderEditor(activeId);
    flashStatus(`// ${viewMode} mode`, 700);
  });

  // Green: fullscreen toggle
  let popupOverlay = null;
  document.getElementById('ide-dot-green')?.addEventListener('click', toggleFullscreen);

  function toggleFullscreen() {
    if (isFullscreen) {
      isFullscreen = false;
      ideWindow.classList.remove('ide-fullscreen');
      ideWindow.parentElement.style.minHeight = '';
      popupOverlay?.remove();
      popupOverlay = null;
      document.removeEventListener('keydown', escFullscreen);
      flashStatus('// exited fullscreen', 700);
    } else {
      isFullscreen = true;
      ideWindow.parentElement.style.minHeight = ideWindow.offsetHeight + 'px';
      ideWindow.classList.add('ide-fullscreen');
      popupOverlay = document.createElement('div');
      popupOverlay.className = 'ide-overlay';
      document.body.appendChild(popupOverlay);
      requestAnimationFrame(() => popupOverlay.classList.add('active'));
      popupOverlay.addEventListener('click', toggleFullscreen);
      document.addEventListener('keydown', escFullscreen);
      flashStatus('// fullscreen mode', 700);
    }
  }
  function escFullscreen(e) { if (e.key === 'Escape') toggleFullscreen(); }

  // ── View toggle (breadcrumb buttons) ──────────────────────────────────────
  viewToggle?.addEventListener('click', e => {
    const btn = e.target.closest('.ide-view-btn');
    if (!btn) return;
    viewMode = btn.dataset.mode;
    showPanel(viewMode);
    if (activeId) renderEditor(activeId);
  });

  // ── Folder toggle ──────────────────────────────────────────────────────────
  document.querySelectorAll('.ide-folder-btn').forEach(btn => {
    const folder  = btn.closest('.ide-folder');
    const files   = folder?.querySelector('.ide-folder-files');
    const chevron = btn.querySelector('.ide-chevron');
    if (files?.classList.contains('open') && chevron) chevron.style.transform = 'rotate(90deg)';
    btn.addEventListener('click', () => {
      if (!files || !chevron) return;
      const isOpen = files.classList.toggle('open');
      chevron.style.transform = isOpen ? 'rotate(90deg)' : 'rotate(0deg)';
      btn.setAttribute('aria-expanded', String(isOpen));
    });
  });
  const rootChevron = document.querySelector('.ide-chevron-root');
  if (rootChevron) rootChevron.style.transform = 'rotate(90deg)';

  // ── File click ─────────────────────────────────────────────────────────────
  getAllFiles().forEach(btn => {
    btn.addEventListener('click', () => openProject(btn.dataset.id ?? ''));
  });

  // ── Keyboard navigation ───────────────────────────────────────────────────
  ideWindow?.addEventListener('keydown', e => {
    const files = getAllFiles().filter(f => f.closest('.ide-folder-files.open'));

    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const dir = e.key === 'ArrowDown' ? 1 : -1;
      focusedFileIdx = Math.max(0, Math.min(files.length - 1, focusedFileIdx + dir));
      files[focusedFileIdx]?.focus();

    } else if (e.key === 'Enter') {
      if (focusedFileIdx >= 0 && files[focusedFileIdx]) {
        openProject(files[focusedFileIdx].dataset.id ?? '');
      }

    } else if (e.key === 'Escape') {
      if (isFullscreen) { toggleFullscreen(); return; }
      if (activeId) { closeTab(activeId, null); return; }
      if (!sidebar.classList.contains('collapsed')) sidebar.classList.add('collapsed');

    } else if (e.key === 'Tab') {
      // Let default Tab work but track focus
    }
  });

  // ── Sidebar toggle button ──────────────────────────────────────────────────
  document.getElementById('ide-sidebar-toggle')?.addEventListener('click', () => {
    sidebar.classList.toggle('collapsed');
  });

  // ── Mobile dropdown ────────────────────────────────────────────────────────
  tabDropdown?.addEventListener('change', () => {
    if (tabDropdown.value) openProject(tabDropdown.value);
  });

  // ── Drag titlebar ──────────────────────────────────────────────────────────
  const titlebar = document.getElementById('ide-titlebar');
  let dragging = false, dragStartX = 0, dragStartY = 0;
  let dragPlaceholder = null;

  function createDragPlaceholder() {
    const r = ideWindow.getBoundingClientRect();
    const el = document.createElement('div');
    el.style.cssText = `
      position: absolute;
      top: ${r.top + window.scrollY}px;
      left: ${r.left + window.scrollX}px;
      width: ${r.width}px;
      height: ${r.height}px;
      border-radius: 8px;
      border: 1px dashed rgba(var(--color-primary-rgb), 0.35);
      background: repeating-linear-gradient(
        -45deg,
        transparent 0px, transparent 6px,
        rgba(var(--color-primary-rgb), 0.04) 6px, rgba(var(--color-primary-rgb), 0.04) 12px
      );
      pointer-events: none;
      z-index: 49;
      opacity: 0;
      transition: opacity 0.15s ease-out;
    `;
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; });
    return el;
  }

  titlebar?.addEventListener('mousedown', e => {
    if (e.target.closest('.ide-dot, .ide-toggle-btn')) return;
    dragging    = true;
    dragStartX  = e.clientX;
    dragStartY  = e.clientY;
    ideWindow.style.transition = 'none';
    ideWindow.classList.add('is-dragging');
    dragPlaceholder = createDragPlaceholder();
    e.preventDefault();
  });

  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    ideWindow.style.transform = `translate(${e.clientX - dragStartX}px, ${e.clientY - dragStartY}px)`;
  });

  window.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    ideWindow.classList.remove('is-dragging');
    if (dragPlaceholder) dragPlaceholder.style.opacity = '0';
    ideWindow.style.transition = 'transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1)';
    ideWindow.style.transform  = 'translate(0,0)';
    ideWindow.addEventListener('transitionend', () => {
      ideWindow.style.transition = '';
      ideWindow.style.transform  = '';
      dragPlaceholder?.remove();
      dragPlaceholder = null;
    }, { once: true });
  });

  // ── Wheel trap (document-level, non-passive) ──────────────────────────────
  // Must be on document with passive:false — element-level listeners can be
  // ignored if a passive ancestor listener was registered first by the browser.
  document.addEventListener('wheel', e => {
    const win = document.getElementById('ide-window');
    if (!win) return;

    // Resolve actual Element (e.target may be a text node)
    let node = e.target instanceof Element ? e.target : e.target?.parentElement;
    if (!node || !win.contains(node)) return;

    // We're inside the IDE — always prevent page scroll
    e.preventDefault();

    // Walk up from the event target to find the first scrollable element
    let scrolled = false;
    let el = node;
    while (el && el !== win) {
      if (el instanceof Element) {
        const oy = getComputedStyle(el).overflowY;
        if ((oy === 'auto' || oy === 'scroll') && el.scrollHeight > el.clientHeight) {
          const atTop    = el.scrollTop === 0 && e.deltaY < 0;
          const atBottom = el.scrollTop + el.clientHeight >= el.scrollHeight - 1 && e.deltaY > 0;
          if (!atTop && !atBottom) { el.scrollTop += e.deltaY; scrolled = true; break; }
        }
      }
      el = el.parentElement;
    }
    // Fallback: always deliver scroll to ide-content
    if (!scrolled) {
      const content = document.getElementById('ide-content');
      if (content) content.scrollTop += e.deltaY;
    }
  }, { passive: false });

  // ── Mobile: collapse sidebar by default ───────────────────────────────────
  if (window.innerWidth < 640) sidebar.classList.add('collapsed');

  // ── Init with boot sequence ───────────────────────────────────────────────
  runBoot(() => { if (defaultId) openProject(defaultId); });
</script>

<style>
  /* ── IDE Window ──────────────────────────────────────────────────────────── */
  .ide-window {
    display: flex;
    flex-direction: column;
    height: 540px;
    position: relative;
