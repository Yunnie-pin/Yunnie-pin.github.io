    box-shadow: 0 0 6px rgba(var(--color-primary-rgb), 0.6);
  }
  .ide-tab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.5;
    transition: opacity 0.2s, box-shadow 0.2s;
