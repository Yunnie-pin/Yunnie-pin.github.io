---
import TerminalCard from './ui/TerminalCard.astro';
import TerminalPrompt from './ui/TerminalPrompt.astro';
import { socials, email } from '../data/contact';
import { siGithub, siGitlab, siDiscord } from 'simple-icons';

// LinkedIn was removed from simple-icons v14+; keep manual SVG path
const ICON_MAP: Record<string, { path: string; hex: string }> = {
  github:   { path: siGithub.path,  hex: 'var(--color-fg)' },
  gitlab:   { path: siGitlab.path,  hex: siGitlab.hex  },
  discord:  { path: siDiscord.path, hex: siDiscord.hex },
  linkedin: {
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
    hex: '0A66C2',
  },
};
---

<section id="contact" class="section">
  <div class="container">

    <!-- Heading -->
    <p class="ascii-divider"><!-- ─────────────────────────────── --></p>
    <h2 class="section-heading glitch" data-text="// contact">// contact</h2>
    <p class="section-subheading">Let's connect!.</p>

    <div class="contact-grid" data-stagger>

      <!-- Left: Message -->
      <TerminalCard title="~/contact/message.txt">
        <div class="msg-body">
          <TerminalPrompt command="cat message.txt" />

          <p class="msg-text">
            Have a technical challenge, project idea, or just want to say hi? I'm all ears! Whether it's a quick question, a potential collaboration, or just sharing cool tech stuff, feel free to reach out. Let's connect and see how we can create something awesome together!
          </p>

          <div class="inset-card">
            <TerminalPrompt command="echo $EMAIL" />
            <div class="email-row">
              <p class="font-mono email-text">
                {email}
              </p>
              <button id="copy-email-btn" class="copy-btn font-mono" data-email={email}>
                [copy]
              </button>
            </div>
          </div>

          <div class="font-mono response-note">
            // Response time: typically within 24 hours
          </div>
        </div>
      </TerminalCard>

      <!-- Right: Social links -->
      <TerminalCard title="~/contact/socials.sh">
        <div class="socials-body">
          <TerminalPrompt command="ls -la socials/" style="margin-bottom: 0.25rem;" />

          {socials.map((social) => {
            const icon = ICON_MAP[social.iconSlug];
            const iconHex = icon?.hex ?? '';
            const color = social.color ?? (iconHex.startsWith('var(') ? iconHex : iconHex ? `#${iconHex}` : 'currentColor');
            return (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-link"
              >
                <span class="social-icon" style={`color: ${color};`}>
                  {icon && (
                    <svg role="img" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                      <path d={icon.path} />
                    </svg>
                  )}
                </span>
                <div class="social-info">
                  <span class="font-mono social-name">{social.name}</span>
                  <span class="font-mono social-handle">{social.handle}</span>
                </div>
                <span class="social-arrow font-mono">→</span>
              </a>
            );
          })}
        </div>
      </TerminalCard>

    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.dataset.email ?? '';
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = '[copied!]';
      copyBtn.classList.add('copied');
    } catch {
      copyBtn.textContent = '[error]';
    }
    setTimeout(() => {
      copyBtn.textContent = '[copy]';
      copyBtn.classList.remove('copied');
    }, 2000);
  });
</script>

<style>
  .copy-btn {
    font-size: 0.68rem;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-fg-dim);
    cursor: pointer;
    transition: var(--transition);
  }
  .copy-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .copy-btn.copied {
    border-color: rgba(var(--color-primary-rgb),0.40);
    color: var(--color-primary);
    background: rgba(var(--color-primary-rgb),0.08);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .social-link {
    --proximity: 0;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(var(--color-primary-rgb), calc(0.12 + 0.20 * var(--proximity)));
    background: var(--color-muted);
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 0 calc(16px * var(--proximity)) rgba(var(--color-primary-rgb), calc(0.10 * var(--proximity)));
    transform: translateX(calc(3px * var(--proximity)));
  }
  .social-link:hover {
    border-color: var(--color-border-bright);
    background: var(--color-elevated);
    transform: translateX(4px);
  }

  .social-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .social-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }

  .social-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-fg);
  }

  .social-handle {
    font-size: 0.72rem;
    color: var(--color-fg-muted);
  }

  .social-arrow {
    font-size: 0.9rem;
    color: var(--color-primary);
    opacity: 0;
    transition: var(--transition);
  }
  .social-link:hover .social-arrow {
    opacity: 1;
  }

  .msg-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .msg-text {
    color: var(--color-fg);
    line-height: 1.8;
  }
  .inset-card {
    padding: 1rem;
    background: var(--color-muted);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }
  .email-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 4px;
    flex-wrap: wrap;
  }
  .email-text {
    font-size: 0.9rem;
    color: var(--color-cyan);
  }
  .response-note {
    font-size: 0.75rem;
    color: var(--color-fg-dim);
  }
  .socials-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
