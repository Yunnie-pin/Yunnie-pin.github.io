---
interface Props {
  title?: string;
  class?: string;
  id?: string;
  showTitlebar?: boolean;
  noPadding?: boolean;
  draggable?: boolean;
}

const {
  title,
  class: className = '',
  id,
  showTitlebar = true,
  noPadding = false,
  draggable = true,
} = Astro.props;
---

<div class={`terminal-card ${className}`} id={id} data-drag-card={draggable && showTitlebar ? '' : undefined}>
  {showTitlebar && (
    <div class="terminal-titlebar" data-drag-handle>
      <span class="terminal-dot dot-red"   title="collapse"></span>
      <span class="terminal-dot dot-yellow" title="restore"></span>
      <span class="terminal-dot dot-green"  title="expand"></span>
      {title && (
        <span class="font-mono" style="font-size: 0.72rem; color: var(--color-fg-muted); margin-left: 8px;">
          {title}
        </span>
      )}
    </div>
  )}
  <div class={noPadding ? '' : 'card-body'} data-card-body>
    <slot />
  </div>
</div>

<script>
  function initDraggableCards() {
    const cards = document.querySelectorAll<HTMLElement>('[data-drag-card]');

    cards.forEach((card) => {
      const handle   = card.querySelector<HTMLElement>('[data-drag-handle]');
      if (!handle) return;

      const dotRed    = handle.querySelector<HTMLElement>('.dot-red');
      const dotYellow = handle.querySelector<HTMLElement>('.dot-yellow');
      const dotGreen  = handle.querySelector<HTMLElement>('.dot-green');
      // ── State ───────────────────────────────────────────────────────────────
      let isDragging    = false;
      let originX       = 0;
      let originY       = 0;
      let placeholder:   HTMLElement | null = null;
      let popupOverlay:  HTMLElement | null = null;
      let recoveryEl:    HTMLElement | null = null;
      let deletedTimer:  ReturnType<typeof setTimeout> | null = null;
      let recoveryTimer: ReturnType<typeof setTimeout> | null = null;

      const DELETED_MS  = 1200;
      const RECOVERY_MS = 3000;

      // ── Recovery animation ──────────────────────────────────────────────────
      function startRecovery() {
        // Phase 1 — deleted indicator
        recoveryEl = document.createElement('div');
        recoveryEl.className = 'tc-recovery tc-recovery-deleted';
        recoveryEl.innerHTML = `<span class="tc-recovery-label">// [ERR] data deleted</span>`;
        handle.insertAdjacentElement('afterend', recoveryEl);

        deletedTimer = setTimeout(() => {
          deletedTimer = null;
          if (!recoveryEl) return;
          // Phase 2 — recovering progress
          recoveryEl.classList.remove('tc-recovery-deleted');
          recoveryEl.innerHTML = `
            <span class="tc-recovery-label">// recovering data</span>
            <div class="tc-recovery-track">
              <div class="tc-recovery-fill" style="animation-duration:${RECOVERY_MS}ms"></div>
            </div>
          `;
          recoveryTimer = setTimeout(() => finishRecovery(true), RECOVERY_MS);
        }, DELETED_MS);
      }

      function finishRecovery(restore = true) {
        if (deletedTimer)  { clearTimeout(deletedTimer);  deletedTimer  = null; }
        if (recoveryTimer) { clearTimeout(recoveryTimer); recoveryTimer = null; }
        if (recoveryEl) {
          recoveryEl.style.opacity   = '0';
          recoveryEl.style.transition = 'opacity 0.25s ease-out';
          const el = recoveryEl;
          setTimeout(() => el.remove(), 260);
          recoveryEl = null;
        }
        if (restore) card.classList.remove('collapsed');
      }

      const isRecovering = () => !!(deletedTimer || recoveryTimer);

      // ── Red dot: close popup if active, else collapse + start recovery ───────
      dotRed?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (card.classList.contains('popup-mode')) { closePopup(); return; }
        if (isRecovering()) { finishRecovery(true); return; }
        if (card.classList.contains('collapsed')) { card.classList.remove('collapsed'); return; }
        card.classList.add('collapsed');
        startRecovery();
      });

      // ── Yellow dot: jiggle popup / cancel recovery / restore / jiggle ────────
      dotYellow?.addEventListener('click', (e) => {
        e.stopPropagation();
        if (card.classList.contains('popup-mode')) {
          card.classList.add('jiggle');
          card.addEventListener('animationend', () => card.classList.remove('jiggle'), { once: true });
          return;
        }
        if (isRecovering()) { finishRecovery(true); return; }
        if (card.classList.contains('collapsed')) {
          card.classList.remove('collapsed');
        } else {
          card.classList.add('jiggle');
          card.addEventListener('animationend', () => card.classList.remove('jiggle'), { once: true });
        }
      });

      // ── Popup open/close ────────────────────────────────────────────────────
      function openPopup() {
        if (card.classList.contains('popup-mode')) return;
        if (recoveryTimer) finishRecovery(false);
        if (card.classList.contains('collapsed')) card.classList.remove('collapsed');

        popupOverlay = document.createElement('div');
        popupOverlay.style.cssText = `
          position: fixed; inset: 0;
          background: rgba(0,0,0,0.65);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
          z-index: 999;
          opacity: 0;
          transition: opacity 0.2s ease-out;
        `;
        document.body.appendChild(popupOverlay);
        requestAnimationFrame(() => { popupOverlay!.style.opacity = '1'; });

        card.classList.add('popup-mode');
        popupOverlay.addEventListener('click', closePopup);
        document.addEventListener('keydown', escHandler);
      }

      function closePopup() {
        if (!card.classList.contains('popup-mode')) return;
        card.classList.add('popup-closing');
        if (popupOverlay) popupOverlay.style.opacity = '0';
        card.addEventListener('animationend', () => {
          card.classList.remove('popup-mode', 'popup-closing');
          popupOverlay?.remove();
          popupOverlay = null;
          document.removeEventListener('keydown', escHandler);
        }, { once: true });
      }

      function escHandler(e: KeyboardEvent) {
        if (e.key === 'Escape') closePopup();
      }

      // ── Green dot: popup toggle ─────────────────────────────────────────────
      dotGreen?.addEventListener('click', (e) => {
        e.stopPropagation();
        card.classList.contains('popup-mode') ? closePopup() : openPopup();
      });

      // ── Double-click titlebar: popup toggle ─────────────────────────────────
      handle.addEventListener('dblclick', (e) => {
        if ((e.target as HTMLElement).closest('.terminal-dot')) return;
        card.classList.contains('popup-mode') ? closePopup() : openPopup();
      });

      // ── Drag placeholder ────────────────────────────────────────────────────
      function createPlaceholder() {
        const r = card.getBoundingClientRect();
        const el = document.createElement('div');
        el.style.cssText = `
          position: absolute;
          top: ${r.top + window.scrollY}px;
          left: ${r.left + window.scrollX}px;
          width: ${r.width}px;
          height: ${r.height}px;
          border-radius: 8px;
          border: 1px dashed rgba(0,255,135,0.35);
          background: repeating-linear-gradient(
            -45deg,
            transparent 0px, transparent 6px,
            rgba(0,255,135,0.04) 6px, rgba(0,255,135,0.04) 12px
          );
          pointer-events: none;
          z-index: 49;
          opacity: 0;
          transition: opacity 0.15s ease-out;
        `;
        document.body.appendChild(el);
        requestAnimationFrame(() => { el.style.opacity = '1'; });
        return el;
      }

      // ── Drag logic ──────────────────────────────────────────────────────────
      function startDrag(clientX: number, clientY: number) {
        if (card.classList.contains('popup-mode')) return;
        isDragging = true;
        originX = clientX;
        originY = clientY;
        card.style.transition = 'none';
        card.classList.add('is-dragging');
        placeholder = createPlaceholder();
      }

      function moveDrag(clientX: number, clientY: number) {
        if (!isDragging) return;
        card.style.transform = `translate(${clientX - originX}px, ${clientY - originY}px)`;
      }

      function endDrag() {
        if (!isDragging) return;
        isDragging = false;
        card.classList.remove('is-dragging');
        if (placeholder) placeholder.style.opacity = '0';
        card.style.transition = 'transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
        card.style.transform = 'translate(0px, 0px)';
        card.addEventListener('transitionend', () => {
          card.style.transition = '';
          card.style.transform = '';
          placeholder?.remove();
          placeholder = null;
        }, { once: true });
      }

      // Mouse
      handle.addEventListener('mousedown', (e) => {
        if ((e.target as HTMLElement).closest('.terminal-dot')) return;
        startDrag(e.clientX, e.clientY);
        e.preventDefault();
      });
      window.addEventListener('mousemove', (e) => moveDrag(e.clientX, e.clientY));
      window.addEventListener('mouseup', () => endDrag());

      // Touch
      handle.addEventListener('touchstart', (e) => {
        if ((e.target as HTMLElement).closest('.terminal-dot')) return;
        startDrag(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      window.addEventListener('touchmove', (e) => {
        if (isDragging) moveDrag(e.touches[0].clientX, e.touches[0].clientY);
      }, { passive: true });
      window.addEventListener('touchend', () => endDrag());
    });
  }

  initDraggableCards();
</script>

<style>
  .card-body {
    padding: 1.25rem 1.5rem;
  }

  /* ── Titlebar cursor ── */
  [data-drag-card] .terminal-titlebar {
    cursor: grab;
    user-select: none;
  }
  [data-drag-card].is-dragging .terminal-titlebar {
    cursor: grabbing;
  }

  /* ── Dragging state ── */
  [data-drag-card].is-dragging {
    box-shadow: 0 8px 32px rgba(0,0,0,0.80), 0 0 28px rgba(0,255,135,0.12);
    border-color: rgba(0,255,135,0.2);
    z-index: 50;
    position: relative;
  }

  /* ── Collapse (red dot) ── */
  [data-card-body] {
    overflow: hidden;
    max-height: 2000px;
    opacity: 1;
    transition: max-height 0.35s ease-out, opacity 0.25s ease-out;
  }
  .terminal-card.collapsed [data-card-body] {
    max-height: 0 !important;
    opacity: 0;
  }
  .terminal-card.collapsed .terminal-titlebar {
    border-bottom: none;
    border-radius: 8px;
  }

  /* ── Jiggle (yellow dot) ── */
  @keyframes jiggle {
    0%, 100% { transform: translateX(0) rotate(0); }
    20%       { transform: translateX(-5px) rotate(-1deg); }
    40%       { transform: translateX(4px)  rotate(1deg); }
    60%       { transform: translateX(-3px) rotate(-0.5deg); }
    80%       { transform: translateX(2px)  rotate(0.5deg); }
  }
  .terminal-card.jiggle {
    animation: jiggle 0.4s ease-out;
  }

  @keyframes jiggle-popup {
    0%, 100% { transform: translate(-50%, -50%) rotate(0); }
    20%       { transform: translate(calc(-50% - 5px), -50%) rotate(-1deg); }
    40%       { transform: translate(calc(-50% + 4px), -50%) rotate(1deg); }
    60%       { transform: translate(calc(-50% - 3px), -50%) rotate(-0.5deg); }
    80%       { transform: translate(calc(-50% + 2px), -50%) rotate(0.5deg); }
  }
  .terminal-card.popup-mode.jiggle {
    animation: jiggle-popup 0.4s ease-out !important;
  }

  /* ── Popup (green dot / dblclick) ── */
  @keyframes popupExpand {
    from { transform: translate(-50%, -50%) scale(0.88); opacity: 0; }
    to   { transform: translate(-50%, -50%) scale(1);    opacity: 1; }
  }
  @keyframes popupCollapse {
    from { transform: translate(-50%, -50%) scale(1);    opacity: 1; }
    to   { transform: translate(-50%, -50%) scale(0.88); opacity: 0; }
  }

  .terminal-card.popup-mode {
    position: fixed !important;
    top: 50% !important;
    left: 50% !important;
    width: min(720px, 90vw) !important;
    max-height: 80vh !important;
    overflow-y: auto !important;
    z-index: 1000 !important;
    margin: 0 !important;
    animation: popupExpand 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  .terminal-card.popup-mode [data-card-body] {
    max-height: none !important;
    opacity: 1 !important;
  }
  .terminal-card.popup-closing {
    animation: popupCollapse 0.2s ease-in forwards !important;
  }

  /* Dot hover feedback */
  .terminal-dot {
    transition: transform 0.15s ease-out, filter 0.15s;
  }
  .terminal-dot:hover {
    transform: scale(1.25);
    filter: brightness(1.3);
  }
</style>

<!-- Recovery bar styles: must be global since element is created via JS -->
<style is:global>
  .tc-recovery {
    padding: 7px 14px 9px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-panel);
  }

  .tc-recovery-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-fg-dim);
    margin-bottom: 6px;
  }

  .tc-recovery-deleted .tc-recovery-label {
    color: #ff5f57;
    animation: tc-deleted-appear 0.15s ease-out;
  }

  @keyframes tc-deleted-appear {
    from { opacity: 0; transform: translateX(-4px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* animated trailing dots */
  .tc-recovery-label::after {
    content: '';
    animation: tc-dots 1.2s steps(4, end) infinite;
  }
  @keyframes tc-dots {
    0%   { content: '';    }
    25%  { content: '.';   }
    50%  { content: '..';  }
    75%  { content: '...'; }
  }

  .tc-recovery-track {
    height: 2px;
    background: var(--color-border);
    border-radius: 1px;
    overflow: hidden;
  }

  .tc-recovery-fill {
    height: 100%;
    width: 0%;
    background: var(--color-primary);
    box-shadow: 0 0 8px rgba(0, 255, 135, 0.55);
    animation: tc-fill linear forwards;
  }
  @keyframes tc-fill {
    from { width: 0%; }
    to   { width: 100%; }
  }
</style>
