---
import Cursor from './decorative/Cursor.astro';
import CmdButton from './ui/CmdButton.astro';
import { typewriterRoles } from '../data/profile';
import { about } from '../data/about';
---

<section id="hero" class="hero-section bg-grid-dots">
  <!-- Particle canvas -->
  <canvas id="hero-particles" aria-hidden="true"></canvas>

  <!-- Scroll cue -->
  <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
    <span class="scroll-cue-label">scroll</span>
    <svg class="scroll-cue-arrow" width="16" height="20" viewBox="0 0 16 20" fill="none" aria-hidden="true">
      <path d="M8 1v14M2 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <div class="container">
    <div class="hero-grid">

      <!-- Left: text content -->
      <div class="hero-content">

        <!-- Terminal boot line (clickable) -->
        <p class="font-mono boot-line animate-fade-up"
           id="boot-line-btn" role="button" tabindex="0"
           aria-expanded="false" aria-controls="hero-terminal">
          <span class="boot-prefix">$</span>
          <span class="boot-cmd"> whoami</span>
          <span class="boot-hint" id="boot-hint">[click to open terminal]</span>
        </p>

        <!-- Name -->
        <h1 class="hero-name animate-fade-up animation-delay-75">
          <span class="phosphor">Arifin</span>
          <span class="hero-name-last"> Yunianta</span>
          <Cursor />
        </h1>

        <!-- Role -->
        <p class="hero-role font-mono animate-fade-up animation-delay-150">
          <span class="role-prefix">&gt;</span>
          <span id="typewriter" class="typewriter-text"> {typewriterRoles[0]}</span>
        </p>

        <!-- Bio -->
        <p class="hero-bio animate-fade-up animation-delay-225">{about.bio}</p>

        <!-- Buttons -->
        <div class="hero-actions animate-fade-up animation-delay-300">
          <CmdButton href="#projects" variant="primary" prefix="$">
            view projects
          </CmdButton>
          <CmdButton href="#contact" variant="outline" prefix="$">
            contact me
          </CmdButton>
          <CmdButton href="/assets/cv.pdf" variant="outline" prefix="↓" target="_blank">
            download cv
          </CmdButton>
        </div>

        <!-- Status indicator -->
        <div class="hero-status animate-fade-up animation-delay-300">
          <span class="status-dot animate-pulse-green"></span>
          <span class="font-mono status-text">
            [STATUS] Available for collaboration
          </span>
        </div>

      </div>

      <!-- Right: logo / terminal -->
      <div class="hero-logo-wrap animate-fade-up animation-delay-225" id="hero-right-col">
        <span class="hero-logo" id="hero-logo-el"></span>

        <!-- Terminal panel (replaces logo when open) -->
        <div id="hero-terminal" class="hero-terminal font-mono" role="dialog" aria-label="Interactive terminal">
          <div class="ht-bar">
            <span class="ht-dot" style="background:#FF5F57;"></span>
            <span class="ht-dot" style="background:#FEBC2E;"></span>
            <span class="ht-dot ht-close" id="ht-close-btn" style="background:#28C840;" title="close"></span>
            <span class="ht-title">~/terminal — arifin@portfolio</span>
          </div>
          <div class="ht-output" id="ht-output"></div>
          <div class="ht-input-row">
            <span class="ht-prompt">$</span>
            <input id="ht-input" class="ht-input" type="text"
                   autocomplete="off" spellcheck="false"
                   placeholder="type a command…" aria-label="Terminal input" />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Boot hint attention pulse + scroll cue -->
<script>
  // Attention pulse on boot hint — fires once after fade-in animation completes
  const bootHint = document.getElementById('boot-hint');
  if (bootHint) {
    setTimeout(() => {
      bootHint.classList.add('attention');
      bootHint.addEventListener('animationend', () => bootHint.classList.remove('attention'), { once: true });
    }, 1200); // after the boot-line fadeUp (75ms delay + 500ms anim + buffer)
  }

  // Scroll cue — hide on first scroll
  const scrollCue = document.getElementById('scroll-cue');
  if (scrollCue) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) scrollCue.classList.add('hidden');
    }, { passive: true });
  }
</script>

<!-- Typewriter script -->
<script define:vars={{ typewriterRoles }}>
  const roles = typewriterRoles;
  let roleIndex = 0;
  let charIndex = roles[0].length; // SSR already rendered first role fully
  let deleting = true;             // jump straight to delete phase

  const el = document.getElementById("typewriter");
  if (el) {
    function type() {
      const current = roles[roleIndex];
      if (!deleting) {
        el.textContent = " " + current.slice(0, ++charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(type, 1800);
          return;
        }
      } else {
        el.textContent = " " + current.slice(0, --charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
        }
      }
      setTimeout(type, deleting ? 60 : 90);
    }
    setTimeout(type, 1800); // pause 1.8s at first role, then start cycling
  }

</script>

<!-- Particle field (Three.js) -->
<script>
  // Skip on mobile or reduced-motion
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 768;

  if (!prefersReduced && !isMobile) {
    // Dynamic import — Three.js only loads on desktop
    const THREE = await import('three');

    const canvas  = document.getElementById('hero-particles') as HTMLCanvasElement | null;
    const section = document.getElementById('hero') as HTMLElement | null;
    if (!canvas || !section) throw new Error('hero canvas missing');

    // ── Renderer ────────────────────────────────────────────────────────────
    let W = section.clientWidth;
    let H = section.clientHeight;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(W, H);
    renderer.setClearColor(0x000000, 0);

    // ── Camera (orthographic = 1:1 screen pixels) ───────────────────────────
    const camera = new THREE.OrthographicCamera(-W/2, W/2, H/2, -H/2, 0.1, 100);
    camera.position.z = 10;

    const scene = new THREE.Scene();

    // ── Particles ────────────────────────────────────────────────────────────
    const COUNT = 140;
    const pos   = new Float32Array(COUNT * 3);
    const vel: { x: number; y: number }[] = [];

    for (let i = 0; i < COUNT; i++) {
      pos[i * 3]     = (Math.random() - 0.5) * W;
      pos[i * 3 + 1] = (Math.random() - 0.5) * H;
      pos[i * 3 + 2] = 0;
      vel.push({ x: (Math.random() - 0.5) * 0.35, y: (Math.random() - 0.5) * 0.35 });
    }

    const dotGeo = new THREE.BufferGeometry();
    dotGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));

    const dotMat = new THREE.PointsMaterial({
      color: 0x00ff87,
      size: 3,
      sizeAttenuation: false,
      transparent: true,
      opacity: 0.65,
    });

    scene.add(new THREE.Points(dotGeo, dotMat));

    // ── Connection lines ─────────────────────────────────────────────────────
    const MAX_SEGS   = (COUNT * (COUNT - 1)) / 2;
    const lineBuf    = new Float32Array(MAX_SEGS * 6);
    const lineGeo    = new THREE.BufferGeometry();
    lineGeo.setAttribute('position', new THREE.BufferAttribute(lineBuf, 3));
    lineGeo.setDrawRange(0, 0);

    const lineMat = new THREE.LineBasicMaterial({
      color: 0x00ff87,
      transparent: true,
      opacity: 0.12,
    });

    scene.add(new THREE.LineSegments(lineGeo, lineMat));

    // ── Color sync with theme picker ─────────────────────────────────────────
    let cachedColor = '';
    function syncColor() {
      const hex = getComputedStyle(document.documentElement)
        .getPropertyValue('--color-primary').trim() || '#00ff87';
      if (hex === cachedColor) return;
      cachedColor = hex;
      const c = new THREE.Color(hex);
      dotMat.color.copy(c);
      lineMat.color.copy(c);
    }

    // ── Mouse repulsion ───────────────────────────────────────────────────────
    let mx = 9999, my = 9999;
    section.addEventListener('mousemove', (e) => {
      const r = section.getBoundingClientRect();
      mx =  (e.clientX - r.left)  - W / 2;
      my = -((e.clientY - r.top)  - H / 2);
    });
    section.addEventListener('mouseleave', () => { mx = 9999; my = 9999; });

    const CONNECT_DIST  = 130;
    const MOUSE_RADIUS  = 110;
    const MOUSE_FORCE   = 0.9;

    // ── Animate ───────────────────────────────────────────────────────────────
    function animate() {
      requestAnimationFrame(animate);
      syncColor();

      // Update positions
      for (let i = 0; i < COUNT; i++) {
        const ix = i * 3;
        const dx = pos[ix] - mx, dy = pos[ix + 1] - my;
        const d  = Math.sqrt(dx * dx + dy * dy);
        if (d < MOUSE_RADIUS && d > 0.01) {
          const f = ((MOUSE_RADIUS - d) / MOUSE_RADIUS) * MOUSE_FORCE;
          vel[i].x += (dx / d) * f;
          vel[i].y += (dy / d) * f;
        }
        vel[i].x *= 0.97;
        vel[i].y *= 0.97;
        pos[ix]     += vel[i].x;
        pos[ix + 1] += vel[i].y;

        // Wrap edges
        if (pos[ix]     >  W / 2) pos[ix]     = -W / 2;
        if (pos[ix]     < -W / 2) pos[ix]     =  W / 2;
        if (pos[ix + 1] >  H / 2) pos[ix + 1] = -H / 2;
        if (pos[ix + 1] < -H / 2) pos[ix + 1] =  H / 2;
      }
      dotGeo.attributes.position.needsUpdate = true;

      // Rebuild connection lines
      let li = 0;
      for (let i = 0; i < COUNT; i++) {
        for (let j = i + 1; j < COUNT; j++) {
          const ddx = pos[i*3] - pos[j*3];
          const ddy = pos[i*3+1] - pos[j*3+1];
          if (ddx*ddx + ddy*ddy < CONNECT_DIST * CONNECT_DIST) {
            lineBuf[li++] = pos[i*3];   lineBuf[li++] = pos[i*3+1]; lineBuf[li++] = 0;
            lineBuf[li++] = pos[j*3];   lineBuf[li++] = pos[j*3+1]; lineBuf[li++] = 0;
          }
        }
      }
      lineGeo.setDrawRange(0, li / 3);
      lineGeo.attributes.position.needsUpdate = true;

      renderer.render(scene, camera);
    }
    animate();

    // ── Resize ────────────────────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      W = section.clientWidth;
      H = section.clientHeight;
      renderer.setSize(W, H);
      camera.left   = -W / 2; camera.right = W / 2;
      camera.top    =  H / 2; camera.bottom = -H / 2;
      camera.updateProjectionMatrix();
    }, { passive: true });
  }
</script>

<!-- Interactive terminal logic -->
<script>
  // ── DOM refs ────────────────────────────────────────────────────────────────
  const bootBtn   = document.getElementById('boot-line-btn')  as HTMLElement | null;
  const terminal  = document.getElementById('hero-terminal')  as HTMLElement | null;
  const output    = document.getElementById('ht-output')      as HTMLElement | null;
  const input     = document.getElementById('ht-input')       as HTMLInputElement | null;
  const closeBtn  = document.getElementById('ht-close-btn')   as HTMLElement | null;
  const rightCol  = document.getElementById('hero-right-col') as HTMLElement | null;
  const logoEl    = document.getElementById('hero-logo-el')   as HTMLElement | null;

  if (!bootBtn || !terminal || !output || !input) throw new Error();

  let isOpen   = false;
  let isTyping = false;
  const history: string[] = [];
  let histIdx = -1;

  // ── Commands ────────────────────────────────────────────────────────────────
  type Lines = string[];
  const COMMANDS: Record<string, () => Lines> = {
    help: () => [
      '',
      `  <span class="tc-green">Available commands:</span>`,
      `  <span class="tc-cyan">whoami</span>       — who am I`,
      `  <span class="tc-cyan">skills</span>       — tech stack`,
      `  <span class="tc-cyan">experience</span>   — work history`,
      `  <span class="tc-cyan">contact</span>      — get in touch`,
      `  <span class="tc-cyan">ls</span>           — list sections`,
      `  <span class="tc-cyan">cat bio.txt</span>  — read my bio`,
      `  <span class="tc-cyan">clear</span>        — clear terminal`,
      `  <span class="tc-cyan">exit</span>         — close terminal`,
      `  <span class="tc-dim">// psst: try "sudo hire me"</span>`,
      '',
    ],
    whoami: () => [
      '',
      `  <span class="tc-green">Arifin Yunianta</span>`,
      `  Backend Developer · Indonesia`,
      `  Go · PHP · Node.Js`,
      `  Status: <span class="tc-green">● Available for collaboration</span>`,
      '',
    ],
    skills: () => [
      '',
      `  <span class="tc-dim">Languages  :</span> Go, PHP, JavaScript`,
      `  <span class="tc-dim">Frameworks :</span> Laravel, Node.Js, Flutter, React`,
      `  <span class="tc-dim">Databases  :</span> MySQL, PostgreSQL, Clickhouse, Firebase`,
      `  <span class="tc-dim">Tools      :</span> Git, Docker, Linux`,
      `  <span class="tc-cyan">Learning   :</span> Go, Kubernetes, Rust`,
      '',
    ],
    experience: () => [
      '',
      `  <span class="tc-green">Backend Developer</span> · PT. Telto Telematis Indonesia`,
      `  <span class="tc-dim">2024 — Present · Onsite</span>`,
      '',
    ],
    contact: () => {
      setTimeout(() => document.getElementById('contact')
        ?.scrollIntoView({ behavior: 'smooth' }), 500);
      return ['', '  Navigating to contact…', `  <span class="tc-green">✓ Done</span>`, ''];
    },
    ls: () => [
      '',
      `  <span class="tc-green">about/</span>  <span class="tc-green">experience/</span>  <span class="tc-green">projects/</span>  <span class="tc-green">contact/</span>`,
      '',
    ],
    'cat bio.txt': () => [
      '',
      `  Backend developer passionate about building`,
      `  efficient, scalable, and maintainable systems.`,
      `  I enjoy database design, API development,`,
      `  and optimizing application performance.`,
      '',
    ],
    'sudo hire me': () => [
      '',
      `  [sudo] password for recruiter: <span class="tc-dim">••••••••</span>`,
      `  Verifying credentials…`,
      `  <span class="tc-green">✓ Great taste in developers: confirmed</span>`,
      `  Fetching package: <span class="tc-cyan">arifin-yunianta@latest</span>`,
      `  Installing  <span class="tc-green">████████████████</span>  100%`,
      '',
      `  <span class="tc-green">✓ Best decision you'll make today.</span>`,
      '',
    ],
    clear: () => [],
    exit:  () => [],
  };

  // ── Helpers ──────────────────────────────────────────────────────────────────
  function addLine(html: string) {
    const div = document.createElement('div');
    div.className = 'ht-line';
    div.innerHTML = html;
    output!.appendChild(div);
    output!.scrollTop = output!.scrollHeight;
  }

  function addPrompt(cmd: string) {
    addLine(`<span class="tc-green">$</span> <span class="tc-fg">${escHtml(cmd)}</span>`);
  }

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function printLines(lines: string[], delay = 40) {
    for (const l of lines) {
      addLine(l);
      output!.scrollTop = output!.scrollHeight;
      await new Promise(r => setTimeout(r, delay));
    }
  }

  async function runCmd(raw: string) {
    if (isTyping) return;
    isTyping = true;
    const cmd = raw.trim();

    if (cmd === '') { isTyping = false; return; }

    addPrompt(cmd);

    if (cmd === 'clear') {
      output!.innerHTML = '';
      isTyping = false;
      return;
    }
    if (cmd === 'exit') {
      isTyping = false;
      closeTerminal();
      return;
    }

    const fn = COMMANDS[cmd.toLowerCase()];
    if (fn) {
      await printLines(fn());
    } else {
      await printLines([
        `  <span class="tc-red">command not found:</span> ${escHtml(cmd)}`,
        `  Type <span class="tc-cyan">help</span> for available commands.`,
        '',
      ]);
    }
    isTyping = false;
  }

  // ── Open / Close ─────────────────────────────────────────────────────────────
  async function openTerminal() {
    isOpen = true;
    output!.innerHTML = '';
    // Show right column on mobile (normally hidden)
    if (window.innerWidth < 768) rightCol?.style.setProperty('display', 'flex');
    // Crossfade: logo out, terminal in
    logoEl?.classList.add('logo-hidden');
    terminal.classList.add('open');
    bootBtn!.setAttribute('aria-expanded', 'true');
    bootBtn!.classList.add('active');
    await new Promise(r => setTimeout(r, 280));
    // Auto-run whoami
    isTyping = true;
    addLine(`<span class="tc-green">$</span> <span class="tc-fg">whoami</span>`);
    await printLines(COMMANDS.whoami(), 45);
    addLine(`  Type <span class="tc-cyan">help</span> for available commands.`);
    addLine('');
    isTyping = false;
    input!.focus();
  }

  function closeTerminal() {
    isOpen = false;
    terminal.classList.remove('open');
    logoEl?.classList.remove('logo-hidden');
    if (window.innerWidth < 768) rightCol?.style.removeProperty('display');
    bootBtn!.setAttribute('aria-expanded', 'false');
    bootBtn!.classList.remove('active');
  }

  // ── Events ──────────────────────────────────────────────────────────────────
  bootBtn.addEventListener('click', () => isOpen ? closeTerminal() : openTerminal());
  bootBtn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); bootBtn.click(); }
  });

  closeBtn?.addEventListener('click', (e) => { e.stopPropagation(); closeTerminal(); });

  input.addEventListener('keydown', async (e) => {
    if (e.key === 'Enter') {
      const cmd = input.value;
      input.value = '';
      if (cmd.trim()) { history.unshift(cmd.trim()); histIdx = -1; }
      await runCmd(cmd);
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      histIdx = Math.min(histIdx + 1, history.length - 1);
      input.value = history[histIdx] ?? '';
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      histIdx = Math.max(histIdx - 1, -1);
      input.value = histIdx < 0 ? '' : history[histIdx];
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeTerminal();
  });
</script>

<style>
  .hero-section {
    min-height: calc(100vh - 56px);
    display: flex;
    align-items: center;
    padding: 4rem 0;
    position: relative;
    overflow: hidden;
  }

  #hero-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* Ambient glow blob */
  .hero-section::before {
    content: '';
    position: absolute;
    top: 20%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0,255,135,0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Two-column grid ── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ── Logo right column ── */
  .hero-logo-wrap {
    display: none;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  @media (min-width: 768px) {
    .hero-logo-wrap {
      display: flex;
    }
  }

  /* Radial glow behind logo */
  .hero-logo-wrap::before {
    content: '';
    position: absolute;
    inset: -15%;
    background: radial-gradient(circle, rgba(0, 255, 135, 0.07) 0%, transparent 65%);
    pointer-events: none;
    transition: background 0.3s;
  }

  .hero-logo {
    display: block;
    width: clamp(200px, 28vw, 340px);
    height: clamp(200px, 28vw, 340px);
    background-color: var(--color-primary);
    -webkit-mask: url('/assets/gula-white.svg') center / contain no-repeat;
    mask: url('/assets/gula-white.svg') center / contain no-repeat;
    opacity: 0.88;
    transition: background-color 0.3s, opacity 0.3s;
  }
  .hero-logo-wrap:hover .hero-logo {
    opacity: 1;
  }

  .boot-line {
    font-size: 0.875rem;
    margin-bottom: 1rem;
    opacity: 0;
    cursor: pointer;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    transition: var(--transition);
  }
  .boot-line:hover .boot-hint { opacity: 1; color: var(--color-primary); }
  .boot-line.active .boot-hint { opacity: 0.4; }
  .boot-line.active > span:nth-child(2) { color: var(--color-primary) !important; }

  .boot-hint {
    font-size: 0.65rem;
    color: var(--color-fg-muted);
    opacity: 0.85;
    transition: opacity 0.2s, color 0.2s;
  }

  /* One-time attention pulse — plays 3x after the boot line fades in */
  @keyframes hintAttention {
    0%, 100% { opacity: 0.85; color: var(--color-fg-muted); }
    50%       { opacity: 1;    color: var(--color-primary); text-shadow: 0 0 8px rgba(0,255,135,0.45); }
  }
  .boot-hint.attention {
    animation: hintAttention 0.9s ease-in-out 3;
  }

  /* Scroll cue */
  @keyframes scrollCueIn {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); }
    55%       { transform: translateY(6px); }
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    animation: scrollCueIn 0.5s ease-out 2.2s forwards;
    transition: opacity 0.4s ease-out;
  }
  .scroll-cue.hidden {
    opacity: 0 !important;
    transition: opacity 0.4s ease-out;
  }
  .scroll-cue-label {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--color-fg-dim);
    letter-spacing: 0.12em;
    text-transform: lowercase;
  }
  .scroll-cue-arrow {
    color: var(--color-primary);
    animation: scrollBounce 1.6s ease-in-out 2.7s infinite;
    opacity: 0.7;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-cue { animation: none; opacity: 1; }
    .scroll-cue-arrow { animation: none; }
    .boot-hint.attention { animation: none; }
  }

  /* ── Logo ↔ Terminal crossfade ──────────────────────────────────────────── */
  .hero-logo-wrap {
    position: relative;
    min-height: clamp(200px, 28vw, 340px);
  }

  .hero-logo {
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }
  .hero-logo.logo-hidden {
    opacity: 0 !important;
    transform: scale(0.92);
    pointer-events: none;
  }

  /* ── Terminal panel ─────────────────────────────────────────────────────── */
  .hero-terminal {
    position: absolute;
    inset: 0;
