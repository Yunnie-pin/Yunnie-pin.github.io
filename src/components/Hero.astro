        lines.push(`  <span class="tc-dim">  ${p.tech.join(' · ')}</span>`);
        lines.push('');
      });
      lines.push(`  <button class="ht-cmd-btn" data-cmd="open projects">→ open projects section</button>`);
      lines.push('');
      return lines;
    },
    pwd: () => ['', `  <span class="tc-green">/home/yunnie-pin/portfolio/yunnie-pin.github.io</span>`, ''],
    date: () => {
      const now = new Date();
      const opts: Intl.DateTimeFormatOptions = { timeZone: 'Asia/Jakarta', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
      return ['', `  <span class="tc-cyan">${now.toLocaleString('en-GB', opts)} WIB</span>`, ''];
    },
    'uname -a': () => [
      '',
      `  <span class="tc-green">Portfolio-OS</span> yunnie-pin 5.0.0-arifin <span class="tc-dim">#1 SMP</span>`,
      `  <span class="tc-dim">Kernel  :</span> Astro v5 + Tailwind v4`,
      `  <span class="tc-dim">Arch    :</span> x86_64 (brain-powered)`,
      `  <span class="tc-dim">Shell   :</span> /bin/portfolio`,
      `  <span class="tc-dim">Uptime  :</span> 3+ years coding`,
      '',
    ],
    'cat cv.pdf': () => {
      setTimeout(() => window.open('/assets/cv.pdf', '_blank'), 400);
      return ['', `  <span class="tc-dim">$ cat cv.pdf | xdg-open</span>`, `  <span class="tc-green">✓ Opening CV…</span>`, ''];
    },
    contact: () => {
      setTimeout(() => document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' }), 500);
      return ['', `  <span class="tc-dim">Navigating to contact…</span>`, `  <span class="tc-green">✓ Done</span>`, ''];
    },
    ls: () => [
      '',
      `  <span class="tc-green">about/</span>  <span class="tc-green">experience/</span>  <span class="tc-green">achievements/</span>  <span class="tc-green">projects/</span>  <span class="tc-green">contact/</span>`,
      '',
    ],
    'cat bio.txt': () => [
      '',
      `  <span class="tc-dim">// bio.txt</span>`,
      `  Backend developer passionate about building`,
      `  efficient, scalable, and maintainable systems.`,
      `  I enjoy database design, API development,`,
      `  and optimizing application performance.`,
      '',
    ],
    // ── Easter eggs ────────────────────────────────────────────────────────────
    'sudo hire me': async () => {
      await printLines([
        '',
        `  <span class="tc-dim">[sudo] password for recruiter:</span> <span class="tc-dim">••••••••</span>`,
        `  <span class="tc-dim">Verifying credentials…</span>`,
      ], 40);
      await new Promise(r => setTimeout(r, 400));
      await printLines([`  <span class="tc-green">✓ Great taste in developers: confirmed</span>`], 0);
      await new Promise(r => setTimeout(r, 300));
      await printLines([`  <span class="tc-dim">Fetching package:</span> <span class="tc-cyan">arifin-yunianta@latest</span>`], 0);
      await new Promise(r => setTimeout(r, 200));
      await animateProgress('  Installing', 16, 70);
      await printLines([
        '',
        `  <span class="tc-green">✓ Best decision you'll make today.</span>`,
        `  <span class="tc-dim">// run: open contact to proceed</span>`,
        '',
      ], 32);
    },
    'rm -rf /': async () => {
      const files = ['usr/', 'bin/', 'lib/', 'etc/', 'home/', 'var/', 'portfolio/'];
      await printLines(['', `  <span class="tc-red">WARNING: destructive operation</span>`], 20);
      for (const f of files) {
        if (abortTyping) break;
        await printLines([`  <span class="tc-dim">removing</span> /${f}<span class="tc-red">…</span>`], 80);
      }
      await printLines([
        `  <span class="tc-red">rm: cannot remove '/': Permission denied</span>`,
        `  <span class="tc-dim">// nice try 😄</span>`,
        '',
      ], 32);
    },
    'git log': () => [
      '',
      `  <span class="tc-yellow">commit a1b2c3d</span> <span class="tc-dim">(HEAD -> main)</span>`,
      `  <span class="tc-dim">Date: Today</span>`,
      `  <span class="tc-fg">    feat: become better developer every day</span>`,
      '',
      `  <span class="tc-yellow">commit f4e5d6c</span>`,
      `  <span class="tc-dim">Date: Yesterday</span>`,
      `  <span class="tc-fg">    fix: resolve caffeine dependency issue</span>`,
      '',
      `  <span class="tc-yellow">commit 7g8h9i0</span>`,
      `  <span class="tc-dim">Date: 2023</span>`,
      `  <span class="tc-fg">    init: started journey as backend developer</span>`,
      '',
    ],
    'npm install': async () => {
      await printLines(['', `  <span class="tc-dim">npm warn</span> deprecated <span class="tc-yellow">sleep@∞.0.0</span>`], 20);
      await animateProgress('  Installing packages', 20, 45);
      await printLines([
        '',
        `  <span class="tc-green">added 999 packages</span> in 3s`,
        `  <span class="tc-dim">// node_modules: 4.2GB (as expected)</span>`,
        '',
      ], 32);
    },
    ping: () => [
      '',
      `  <span class="tc-dim">PING yunnie-pin.github.io:</span>`,
      `  64 bytes from 127.0.0.1: icmp_seq=1 ttl=64 time=<span class="tc-green">1ms</span>`,
      `  64 bytes from 127.0.0.1: icmp_seq=2 ttl=64 time=<span class="tc-green">1ms</span>`,
      `  64 bytes from 127.0.0.1: icmp_seq=3 ttl=64 time=<span class="tc-green">1ms</span>`,
      `  <span class="tc-dim">— round-trip min/avg/max = 1/1/1 ms</span>`,
      '',
    ],
    history: () => {
      if (history.length === 0) return ['', `  <span class="tc-dim">(no history yet)</span>`, ''];
      const lines: Lines = [''];
      history.slice().reverse().forEach((c, i) => {
        lines.push(`  <span class="tc-dim">${String(i + 1).padStart(3)}</span>  <span class="tc-fg">${escHtml(c)}</span>`);
      });
      lines.push('');
      return lines;
    },
    clear: () => [],
    exit:  () => [],
  };

  // ── Run command ───────────────────────────────────────────────────────────────
  async function runCmd(raw: string) {
    if (isTyping) return;
    isTyping    = true;
    abortTyping = false;
    const cmd = raw.trim();

    if (cmd === '') { isTyping = false; return; }

    addPrompt(cmd);

    // Typing indicator
    const indEl = document.createElement('div');
    indEl.className = 'ht-line';
    indEl.innerHTML = '  <span class="tc-dim animate-blink">▋</span>';
    output!.appendChild(indEl);
    output!.scrollTop = output!.scrollHeight;

    if (cmd === 'clear') {
      output!.innerHTML = '';
      isTyping = false;
      return;
    }
    if (cmd === 'exit') {
      indEl.remove();
      isTyping = false;
      closeTerminal();
      return;
    }

    // open [section] handler
    if (cmd.toLowerCase().startsWith('open ')) {
      const section = cmd.slice(5).trim().toLowerCase();
      indEl.remove();
      if (VALID_SECTIONS.includes(section)) {
        setTimeout(() => document.getElementById(section)?.scrollIntoView({ behavior: 'smooth' }), 300);
        await printLines(['', `  Navigating to <span class="tc-cyan">${escHtml(section)}</span>…`, `  <span class="tc-green">✓ Done</span>`, '']);
      } else {
        await printLines([
          `  <span class="tc-red">unknown section:</span> ${escHtml(section)}`,
          `  Valid: <span class="tc-cyan">${VALID_SECTIONS.join('  ')}</span>`,
          '',
        ]);
      }
      isTyping = false;
      return;
    }

    const fn = COMMANDS[cmd.toLowerCase()];
    indEl.remove();
    if (fn) {
      const result = fn();
      if (result instanceof Promise) {
        await result;
      } else {
        await printLines(result);
      }
    } else {
      await printLines([
        `  <span class="tc-red">command not found:</span> ${escHtml(cmd)}`,
        `  Type <span class="tc-cyan">help</span> for available commands.`,
        '',
      ]);
    }
    isTyping = false;
  }

  // ── Open / Close ─────────────────────────────────────────────────────────────
  async function openTerminal() {
    isOpen = true;
    output!.innerHTML = '';
    // Show right column on mobile (normally hidden)
    if (window.innerWidth < 768) rightCol?.style.setProperty('display', 'flex');
    // Hide floating badges, crossfade: logo out, terminal in
    rightCol?.classList.add('terminal-open');
    logoEl?.classList.add('logo-hidden');
    terminal.classList.add('open');
    bootBtn!.setAttribute('aria-expanded', 'true');
    bootBtn!.classList.add('active');
    await new Promise(r => setTimeout(r, 280));
    // Welcome banner
    isTyping = true;
    await printLines([
      '',
      `  <span class="tc-green">┌──────────────────────────────┐</span>`,
      `  <span class="tc-green">│</span>  yunnie-pin@127.0.0.1  <span class="tc-green">│</span>`,
      `  <span class="tc-green">└──────────────────────────────┘</span>`,
      '',
      `  <span class="tc-dim">Last login:</span> ${new Date().toDateString()}`,
      '',
      `  Type <span class="tc-cyan">help</span> to see available commands.`,
      '',
    ], 28);
    isTyping = false;
    input!.focus();
  }

  function closeTerminal() {
    isOpen = false;
    terminal.classList.remove('open');
    logoEl?.classList.remove('logo-hidden');
    rightCol?.classList.remove('terminal-open');
    if (window.innerWidth < 768) rightCol?.style.removeProperty('display');
    bootBtn!.setAttribute('aria-expanded', 'false');
    bootBtn!.classList.remove('active');
  }

  async function openTerminalAsPopup() {
    // Already open as popup — do nothing
    if (isOpen && terminal.classList.contains('ht-popup-mode')) return;

    // Already open in hero — just portal it to popup
    if (isOpen) { openHtPopup(); return; }

    // Not open yet — open directly as popup (no hero scroll needed)
    isOpen = true;
    output!.innerHTML = '';

    // Hide floating badges in hero
    rightCol?.classList.add('terminal-open');
    logoEl?.classList.add('logo-hidden');
    popupFromTab = true;

    // Portal terminal to body immediately
    htPortalParent = terminal.parentElement;
    htPortalNextSibling = terminal.nextElementSibling;
    document.body.appendChild(terminal);

    htPopupOverlay = document.createElement('div');
    htPopupOverlay.style.cssText = `
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.72);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.2s ease-out;
    `;
    document.body.appendChild(htPopupOverlay);
    requestAnimationFrame(() => { htPopupOverlay!.style.opacity = '1'; });
    terminal.classList.add('ht-popup-mode', 'open');
    htPopupOverlay.addEventListener('click', closeHtPopup);
    document.addEventListener('keydown', htEscHandler);

    bootBtn!.setAttribute('aria-expanded', 'true');
    bootBtn!.classList.add('active');

    await new Promise(r => setTimeout(r, 280));
    isTyping = true;
    await printLines([
      '',
      `  <span class="tc-green">┌──────────────────────────────┐</span>`,
      `  <span class="tc-green">│</span>  yunnie-pin@127.0.0.1  <span class="tc-green">│</span>`,
      `  <span class="tc-green">└──────────────────────────────┘</span>`,
      '',
      `  <span class="tc-dim">Last login:</span> ${new Date().toDateString()}`,
      '',
      `  Type <span class="tc-cyan">help</span> to see available commands.`,
      '',
    ], 28);
    isTyping = false;
    input!.focus();
  }

  // ── Events ──────────────────────────────────────────────────────────────────
  // Enter/Space need no handler — bootBtn is a real <button>.
  bootBtn.addEventListener('click', () => {
    if (isOpen) {
      terminal.classList.contains('ht-popup-mode') ? closeHtPopup() : closeTerminal();
      return;
    }
    // Below 768px the hero's right column is display:none and the grid
    // collapses to one column, so an inline terminal would open below the
    // fold with no feedback. The popup is fixed + centred, so it is always
    // in view and already handles overlay/Esc/restore.
    if (window.innerWidth < 768) openTerminalAsPopup();
    else openTerminal();
  });

  const redBtn    = document.getElementById('ht-red-btn')    as HTMLElement | null;
  const yellowBtn = document.getElementById('ht-yellow-btn') as HTMLElement | null;

  // Red: close popup if in popup mode, otherwise close terminal
  redBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (terminal.classList.contains('ht-popup-mode')) { closeHtPopup(); return; }
    closeTerminal();
  });

  // Yellow: jiggle
  yellowBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    terminal.classList.add('ht-jiggle');
    terminal.addEventListener('animationend', () => terminal.classList.remove('ht-jiggle'), { once: true });
  });

  // Green: popup toggle (portal to body to escape stacking context)
  let htPopupOverlay: HTMLElement | null = null;
  let htPortalParent: HTMLElement | null = null;
  let htPortalNextSibling: Element | null = null;

  function openHtPopup() {
    if (terminal.classList.contains('ht-popup-mode')) return;

    // Portal: move terminal to body so z-index is in the global stacking context
    htPortalParent = terminal.parentElement;
    htPortalNextSibling = terminal.nextElementSibling;
    document.body.appendChild(terminal);

    htPopupOverlay = document.createElement('div');
    htPopupOverlay.style.cssText = `
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.72);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      z-index: 999;
      opacity: 0;
      transition: opacity 0.2s ease-out;
    `;
    document.body.appendChild(htPopupOverlay);
    requestAnimationFrame(() => { htPopupOverlay!.style.opacity = '1'; });
    terminal.classList.add('ht-popup-mode');
    htPopupOverlay.addEventListener('click', closeHtPopup);
    document.addEventListener('keydown', htEscHandler);
  }

  function closeHtPopup() {
    if (!terminal.classList.contains('ht-popup-mode')) return;
    terminal.classList.add('ht-popup-closing');
    if (htPopupOverlay) htPopupOverlay.style.opacity = '0';

    let cleaned = false;
    function doCleanup() {
      if (cleaned) return;
      cleaned = true;
      terminal.classList.remove('ht-popup-mode', 'ht-popup-closing');
      htPopupOverlay?.remove();
      htPopupOverlay = null;
      // Restore terminal to original position in DOM
      if (htPortalParent) {
        htPortalParent.insertBefore(terminal, htPortalNextSibling);
        htPortalParent = null;
        htPortalNextSibling = null;
      }
      document.removeEventListener('keydown', htEscHandler);
      // If popup was opened from a section tab, fully close terminal + restore hero
      if (popupFromTab) {
        popupFromTab = false;
        closeTerminal();
      }
    }

    terminal.addEventListener('animationend', doCleanup, { once: true });
    setTimeout(doCleanup, 300); // fallback: ensures cleanup runs even if animationend doesn't fire
  }

  function htEscHandler(e: KeyboardEvent) {
    if (e.key === 'Escape') {
      if (terminal.classList.contains('ht-popup-mode')) { closeHtPopup(); return; }
      if (isOpen) closeTerminal();
    }
  }

  closeBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    terminal.classList.contains('ht-popup-mode') ? closeHtPopup() : openHtPopup();
  });

  input.addEventListener('keydown', async (e) => {
    if (e.key === 'Enter') {
      const cmd = input.value;
      input.value = '';
      if (cmd.trim()) { history.unshift(cmd.trim()); histIdx = -1; }
      await runCmd(cmd);
    }
    if (e.ctrlKey && e.key === 'l') {
      e.preventDefault();
      output!.innerHTML = '';
    }
    if (e.ctrlKey && e.key === 'c') {
      e.preventDefault();
      if (isTyping) {
        abortTyping = true;
        addLine(`<span class="tc-dim">^C</span>`);
        isTyping = false;
      }
    }
    if (e.key === 'Tab') {
      e.preventDefault();
      const val = input.value;
      if (!val.trim()) return;

      // Tab completion for "open [section]"
      if (val.toLowerCase().startsWith('open ')) {
        const partial = val.slice(5).toLowerCase();
        const sectionMatches = VALID_SECTIONS.filter(s => s.startsWith(partial));
        if (sectionMatches.length === 1) {
          input.value = `open ${sectionMatches[0]}`;
        } else if (sectionMatches.length > 1) {
          addLine('');
          addLine(`  ${sectionMatches.map(s => `<span class="tc-cyan">${s}</span>`).join('  ')}`);
          addLine('');
        }
        return;
      }

      // Default tab completion for top-level commands
      const cmds = Object.keys(COMMANDS);
      const matches = cmds.filter(c => c.startsWith(val.toLowerCase()));
      if (matches.length === 1) {
        input.value = matches[0];
      } else if (matches.length > 1) {
        addLine('');
        addLine(`  ${matches.map(m => `<span class="tc-cyan">${escHtml(m)}</span>`).join('  ')}`);
        addLine('');
      }
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      histIdx = Math.min(histIdx + 1, history.length - 1);
      input.value = history[histIdx] ?? '';
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      histIdx = Math.max(histIdx - 1, -1);
      input.value = histIdx < 0 ? '' : history[histIdx];
    }
  });

  // Click delegation for clickable commands in help output
  output.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-cmd]') as HTMLElement | null;
    if (!btn || isTyping) return;
    const cmd = btn.dataset.cmd;
    if (cmd) runCmd(cmd);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (terminal.classList.contains('ht-popup-mode')) return; // htEscHandler handles it
    if (isOpen) closeTerminal();
  });

  // ── Drag to peek (snap back on release) ────────────────────────────────────
  const htBar = terminal.querySelector('.ht-bar') as HTMLElement | null;
  let isDragging = false;
  let dragOriginX = 0;
  let dragOriginY = 0;
  let dragPlaceholder: HTMLElement | null = null;

  function createDragPlaceholder() {
    const r = terminal.getBoundingClientRect();
    const el = document.createElement('div');
    el.style.cssText = `
      position: absolute;
      top: ${r.top + window.scrollY}px;
      left: ${r.left + window.scrollX}px;
      width: ${r.width}px;
      height: ${r.height}px;
      border-radius: 8px;
      border: 1px dashed rgba(var(--color-primary-rgb),0.35);
      background: repeating-linear-gradient(
        -45deg,
        transparent 0px,
        transparent 6px,
        rgba(var(--color-primary-rgb),0.04) 6px,
        rgba(var(--color-primary-rgb),0.04) 12px
      );
      pointer-events: none;
      z-index: 49;
      opacity: 0;
      transition: opacity 0.15s ease-out;
    `;
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.opacity = '1'; });
    return el;
  }

  function startDrag(clientX: number, clientY: number) {
    isDragging = true;
    dragOriginX = clientX;
    dragOriginY = clientY;
    terminal.style.transition = 'none';
    terminal.classList.add('is-dragging');
    dragPlaceholder = createDragPlaceholder();
  }

  function moveDrag(clientX: number, clientY: number) {
    if (!isDragging) return;
    const dx = clientX - dragOriginX;
    const dy = clientY - dragOriginY;
    terminal.style.transform = `scale(1) translate(${dx}px, ${dy}px)`;
  }

  function endDrag() {
    if (!isDragging) return;
    isDragging = false;
    terminal.classList.remove('is-dragging');
    if (dragPlaceholder) dragPlaceholder.style.opacity = '0';
    terminal.style.transition = 'transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1)';
    terminal.style.transform = 'scale(1) translateY(0)';
    terminal.addEventListener('transitionend', () => {
      terminal.style.transition = '';
      terminal.style.transform = '';
      dragPlaceholder?.remove();
      dragPlaceholder = null;
    }, { once: true });
  }

  // Double-click titlebar: popup toggle
  htBar?.addEventListener('dblclick', (e) => {
    if ((e.target as HTMLElement).closest('.ht-dot')) return;
    terminal.classList.contains('ht-popup-mode') ? closeHtPopup() : openHtPopup();
  });

  // Mouse
  htBar?.addEventListener('mousedown', (e) => {
    if ((e.target as HTMLElement).closest('.ht-dot')) return;
    startDrag(e.clientX, e.clientY);
    e.preventDefault();
  });
  window.addEventListener('mousemove', (e) => moveDrag(e.clientX, e.clientY));
  window.addEventListener('mouseup', () => endDrag());

  // Touch
  htBar?.addEventListener('touchstart', (e) => {
    if ((e.target as HTMLElement).closest('.ht-dot')) return;
    startDrag(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  window.addEventListener('touchmove', (e) => {
    if (isDragging) moveDrag(e.touches[0].clientX, e.touches[0].clientY);
  }, { passive: true });
  window.addEventListener('touchend', () => endDrag());

  // ── Section tab header → open terminal as popup with "open [section]" ───────
  document.querySelectorAll<HTMLElement>('.section-tab-label[data-section]').forEach(el => {
    el.style.cursor = 'pointer';
    el.addEventListener('click', async () => {
      const section = el.dataset.section!;
      await openTerminalAsPopup();
      await runCmd(`open ${section}`);
      input!.value = '';
    });
  });
</script>

<style>
  .hero-section {
    /* dvh tracks the *current* viewport, so the hero doesn't overflow behind
       mobile browser chrome. The vh line is the fallback for older engines. */
    height: 100vh;
    height: 100dvh;
    display: flex;
    align-items: center;
    padding: 4rem 0;
    position: sticky;
    top: 0;
    z-index: 1;
    overflow: hidden;
  }

  @media (max-width: 1023px) {
    .hero-section {
      height: calc(100vh - 48px);
      height: calc(100dvh - 48px);
      position: relative; /* mobile: normal scroll */
      top: auto;
    }
  }

  #hero-particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  /* Decorative corner gears — mirrors .tc-gear on TerminalCard.
     `translate` is kept separate from the rotate animation so the two
     don't overwrite each other on the same transform property. */
  .hero-gear {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .hero-gear-br {
    bottom: 0;
    right: 0;
    width: clamp(560px, 72vw, 960px);
    height: clamp(560px, 72vw, 960px);
    translate: 38% 38%;
    color: rgba(var(--color-primary-rgb), 0.09);
    animation: gear-spin 24s linear infinite;
  }

  /* Smaller and counter-rotating, so the pair reads as meshed gears */
  .hero-gear-tl {
    top: 0;
    left: 0;
    width: clamp(300px, 40vw, 530px);
    height: clamp(300px, 40vw, 530px);
    translate: -38% -38%;
    color: rgba(var(--color-primary-rgb), 0.07);
    animation: gear-spin 34s linear infinite reverse;
  }

  @keyframes gear-spin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  @media (max-width: 767px) {
    .hero-gear-br {
      width: 480px;
      height: 480px;
      color: rgba(var(--color-primary-rgb), 0.07);
    }
    .hero-gear-tl {
      width: 280px;
      height: 280px;
      color: rgba(var(--color-primary-rgb), 0.055);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-gear { animation: none; }
  }

  .container {
    position: relative;
    z-index: 1;
  }

  /* Ambient glow blob */
  .hero-section::before {
    content: '';
    position: absolute;
    top: 20%;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(var(--color-primary-rgb),0.04) 0%, transparent 70%);
    pointer-events: none;
  }

  /* ── Two-column grid ── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 3rem;
    position: relative;
  }
  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Card surface behind the grid — translucent so the particle field and
     corner gears still read through it. z-index -1 stays inside .container's
     stacking context, so it sits above the canvas but below the content. */
  .hero-grid::before {
    content: '';
    position: absolute;
    inset: -1.5rem -1rem;
    z-index: -1;
    pointer-events: none;
    background: color-mix(in srgb, var(--color-panel) 62%, transparent);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 768px) {
    .hero-grid::before {
      inset: -2.5rem -1.5rem;
    }
  }

  /* Vertical split down the middle of the card, sitting in the grid gap.
     Hidden below 768px, where the grid collapses to a single column and
     .hero-logo-wrap is display:none — a centre line would cut the text. */
  .hero-grid::after {
    content: '';
    display: none;
    position: absolute;
    top: -2.5rem;
    bottom: -2.5rem;
    left: 50%;
    width: 1px;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border-bright) 18%,
      var(--color-border-bright) 82%,
      transparent
    );
  }
  @media (min-width: 768px) {
    .hero-grid::after {
      display: block;
    }
  }

  /* ── Logo right column ── */
  .hero-logo-wrap {
    display: none;
    align-items: center;
    justify-content: center;
    position: relative;
    will-change: transform, opacity;
  }
  @media (min-width: 768px) {
    .hero-logo-wrap {
      display: flex;
    }
  }

  /* Radial glow behind logo */
  .hero-logo-wrap::before {
    content: '';
    position: absolute;
    inset: -15%;
    background: radial-gradient(circle, rgba(var(--color-primary-rgb),0.07) 0%, transparent 65%);
    pointer-events: none;
    transition: background 0.3s;
  }

  .hero-logo {
