---
import Cursor from './decorative/Cursor.astro';
import CmdButton from './ui/CmdButton.astro';
import { typewriterRoles } from '../data/profile';
import { about } from '../data/about';
import { achievements } from '../data/achievements';
import { getCollection } from 'astro:content';

const _achData = achievements.map(a => ({ title: a.title, issuer: a.issuer, date: a.date, rank: a.rank }));
const _projectEntries = await getCollection('projects');
const _prjData = _projectEntries.map(e => ({ title: e.data.title, tech: e.data.tech, status: e.data.status }));
---

<section id="hero" class="hero-section bg-grid-dots">
  <!-- Particle canvas -->
  <canvas id="hero-particles" aria-hidden="true"></canvas>

  <!-- Decorative corner gears — shape defined once, reused by each corner -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <symbol id="hero-gear-shape" viewBox="0 0 24 24" fill="none">
      <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M19.622 10.395l-1.097-2.65L20 6l-2-2-1.735 1.483-2.707-1.113L12.935 2h-1.954l-.632 2.401-2.645 1.115L6 4 4 6l1.453 1.789-1.08 2.657L2 11v2l2.401.655L5.516 16.3 4 18l2 2 1.791-1.46 2.606 1.072L11 22h2l.604-2.387 2.651-1.098C16.697 18.831 18 20 18 20l2-2-1.484-1.75 1.098-2.652L22 13v-2l-2.378-.605Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </symbol>
  </svg>

  <svg class="hero-gear hero-gear-tl" aria-hidden="true"><use href="#hero-gear-shape" /></svg>
  <svg class="hero-gear hero-gear-br" aria-hidden="true"><use href="#hero-gear-shape" /></svg>

  <!-- Scroll cue -->
  <div class="scroll-cue" id="scroll-cue" aria-hidden="true">
    <span class="scroll-cue-label">scroll</span>
    <svg class="scroll-cue-arrow" width="16" height="20" viewBox="0 0 16 20" fill="none" aria-hidden="true">
      <path d="M8 1v14M2 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <div class="container">
    <div class="hero-grid">

      <!-- Left: text content -->
      <div class="hero-content">

        <!-- Terminal boot line (clickable) -->
        <button type="button" class="font-mono boot-line animate-fade-up"
                id="boot-line-btn"
                aria-expanded="false" aria-controls="hero-terminal">
          <span class="boot-prefix">$</span>
          <span class="boot-cmd"> whoami</span>
          <span class="boot-hint" id="boot-hint"><span id="boot-hint-text"></span><span class="boot-cursor" id="boot-cursor" aria-hidden="true">▋</span></span>
        </button>

        <!-- Name -->
        <!-- No animation-delay: this is the LCP element, so it must not be
             held at opacity 0 longer than necessary. -->
        <h1 class="hero-name animate-fade-up">
          <span class="phosphor">Arifin</span>
          <span class="hero-name-last"> Yunianta</span>
          <Cursor />
        </h1>

        <!-- Role -->
        <p class="hero-role font-mono animate-fade-up animation-delay-150">
          <span class="role-prefix">&gt;</span>
          <span id="typewriter" class="typewriter-text"> {typewriterRoles[0]}</span>
        </p>

        <!-- Bio -->
        <p class="hero-bio animate-fade-up animation-delay-225">{about.bio}</p>

        <!-- Buttons -->
        <div class="hero-actions animate-fade-up animation-delay-300">
          <!-- <CmdButton href="#projects" variant="primary" prefix="$">
            view projects
          </CmdButton> -->
          <CmdButton href="#contact" variant="primary" prefix="$">
            contact me
          </CmdButton>
          <CmdButton href="/assets/cv.pdf" variant="outline" prefix="↓" target="_blank">
            download cv
          </CmdButton>
        </div>

        <!-- Status indicator -->
        <div class="hero-status animate-fade-up animation-delay-300">
          <span class="status-dot animate-pulse-green"></span>
          <span class="font-mono status-text">
            [STATUS] Available for collaboration
          </span>
        </div>

      </div>

      <!-- Right: logo / terminal -->
      <div class="hero-logo-wrap animate-fade-up animation-delay-225" id="hero-right-col">

        <span class="hero-logo" id="hero-logo-el"></span>

        <!-- Terminal panel (replaces logo when open) -->
        <div id="hero-terminal" class="hero-terminal font-mono" role="dialog" aria-label="Interactive terminal">
          <div class="ht-bar">
            <span class="ht-dot ht-dot-action" id="ht-red-btn"    style="background:#FF5F57;" title="close"></span>
            <span class="ht-dot ht-dot-action" id="ht-yellow-btn" style="background:#FEBC2E;" title="clear output"></span>
            <span class="ht-dot ht-close"      id="ht-close-btn"  style="background:#28C840;" title="close"></span>
            <span class="ht-title">~/terminal — arifin@portfolio</span>
          </div>
          <div class="ht-output" id="ht-output"></div>
          <div class="ht-input-row">
            <span class="ht-prompt">$</span>
            <input id="ht-input" class="ht-input" type="text"
                   autocomplete="off" spellcheck="false"
                   placeholder="type a command…" aria-label="Terminal input" />
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Boot hint attention pulse + scroll cue -->
<script>
  // Typewriter reveal for boot hint
  const bootHintText   = document.getElementById('boot-hint-text');
  const bootCursorEl   = document.getElementById('boot-cursor');

  if (bootHintText && bootCursorEl) {
    const FULL_TEXT  = '[click to open terminal]';
    const CHAR_DELAY = 42; // ms per character
    const START_DELAY = 900; // after fade-in completes

    async function typeHint() {
      bootCursorEl.classList.add('boot-cursor-blink'); // start blink while typing
      for (let i = 0; i <= FULL_TEXT.length; i++) {
        bootHintText.textContent = FULL_TEXT.slice(0, i);
        await new Promise(r => setTimeout(r, CHAR_DELAY));
      }
      // typing done — cursor keeps blinking
    }

    setTimeout(typeHint, START_DELAY);
  }

  // Scroll cue — hide on first scroll
  const scrollCue = document.getElementById('scroll-cue');
  if (scrollCue) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) scrollCue.classList.add('hidden');
    }, { passive: true });
  }

</script>

<!-- Typewriter script -->
<script define:vars={{ typewriterRoles }} is:inline>
  const roles = typewriterRoles;
  let roleIndex = 0;
  let charIndex = roles[0].length; // SSR already rendered first role fully
  let deleting = true;             // jump straight to delete phase

  const el = document.getElementById("typewriter");
  if (el) {
    function type() {
      const current = roles[roleIndex];
      if (!deleting) {
        el.textContent = " " + current.slice(0, ++charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(type, 1800);
          return;
        }
      } else {
        el.textContent = " " + current.slice(0, --charIndex);
        if (charIndex === 0) {
          deleting = false;
          roleIndex = (roleIndex + 1) % roles.length;
        }
      }
      setTimeout(type, deleting ? 60 : 90);
    }
    setTimeout(type, 1800); // pause 1.8s at first role, then start cycling
  }

</script>

<!-- Particle field (Three.js) -->
<script>
  // Skip on mobile or reduced-motion
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isMobile = window.innerWidth < 768;

  if (!prefersReduced && !isMobile) {
    // Dynamic import — Three.js only loads on desktop
    const THREE = await import('three');

    const canvas  = document.getElementById('hero-particles') as HTMLCanvasElement | null;
    const section = document.getElementById('hero') as HTMLElement | null;
    if (!canvas || !section) throw new Error('hero canvas missing');

    // ── Renderer ────────────────────────────────────────────────────────────
    let W = section.clientWidth;
    let H = section.clientHeight;

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.setSize(W, H);
    renderer.setClearColor(0x000000, 0);

    // ── Camera (orthographic = 1:1 screen pixels) ───────────────────────────
    const camera = new THREE.OrthographicCamera(-W/2, W/2, H/2, -H/2, 0.1, 100);
    camera.position.z = 10;

    const scene = new THREE.Scene();

    // ── Particles ────────────────────────────────────────────────────────────
    const COUNT = 140;
    const pos   = new Float32Array(COUNT * 3);
    const vel: { x: number; y: number }[] = [];

    for (let i = 0; i < COUNT; i++) {
      pos[i * 3]     = (Math.random() - 0.5) * W;
      pos[i * 3 + 1] = (Math.random() - 0.5) * H;
      pos[i * 3 + 2] = 0;
      vel.push({ x: (Math.random() - 0.5) * 0.35, y: (Math.random() - 0.5) * 0.35 });
    }

    const dotGeo = new THREE.BufferGeometry();
    dotGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));

    const dotMat = new THREE.PointsMaterial({
      color: 0x00ff87,
      size: 3,
      sizeAttenuation: false,
      transparent: true,
      opacity: 0.65,
    });

    scene.add(new THREE.Points(dotGeo, dotMat));

    // ── Connection lines ─────────────────────────────────────────────────────
    const MAX_SEGS   = (COUNT * (COUNT - 1)) / 2;
    const lineBuf    = new Float32Array(MAX_SEGS * 6);
    const lineGeo    = new THREE.BufferGeometry();
    lineGeo.setAttribute('position', new THREE.BufferAttribute(lineBuf, 3));
    lineGeo.setDrawRange(0, 0);

    const lineMat = new THREE.LineBasicMaterial({
      color: 0x00ff87,
      transparent: true,
      opacity: 0.12,
    });

    scene.add(new THREE.LineSegments(lineGeo, lineMat));

    // ── Color sync with theme picker ─────────────────────────────────────────
    let cachedColor = '';
    function syncColor() {
      const hex = getComputedStyle(document.documentElement)
        .getPropertyValue('--color-primary').trim() || '#00ff87';
      if (hex === cachedColor) return;
      cachedColor = hex;
      const c = new THREE.Color(hex);
      dotMat.color.copy(c);
      lineMat.color.copy(c);
    }

    // ── Mouse repulsion ───────────────────────────────────────────────────────
    let mx = 9999, my = 9999;
    section.addEventListener('mousemove', (e) => {
      const r = section.getBoundingClientRect();
      mx =  (e.clientX - r.left)  - W / 2;
      my = -((e.clientY - r.top)  - H / 2);
    });
    section.addEventListener('mouseleave', () => { mx = 9999; my = 9999; });

    const CONNECT_DIST  = 130;
    const MOUSE_RADIUS  = 110;
    const MOUSE_FORCE   = 0.9;

    // ── Animate ───────────────────────────────────────────────────────────────
    function animate() {
      requestAnimationFrame(animate);
      syncColor();

      // Update positions
      for (let i = 0; i < COUNT; i++) {
        const ix = i * 3;
        const dx = pos[ix] - mx, dy = pos[ix + 1] - my;
        const d  = Math.sqrt(dx * dx + dy * dy);
        if (d < MOUSE_RADIUS && d > 0.01) {
          const f = ((MOUSE_RADIUS - d) / MOUSE_RADIUS) * MOUSE_FORCE;
          vel[i].x += (dx / d) * f;
          vel[i].y += (dy / d) * f;
        }
        vel[i].x *= 0.97;
        vel[i].y *= 0.97;
        pos[ix]     += vel[i].x;
        pos[ix + 1] += vel[i].y;

        // Wrap edges
        if (pos[ix]     >  W / 2) pos[ix]     = -W / 2;
        if (pos[ix]     < -W / 2) pos[ix]     =  W / 2;
        if (pos[ix + 1] >  H / 2) pos[ix + 1] = -H / 2;
        if (pos[ix + 1] < -H / 2) pos[ix + 1] =  H / 2;
      }
      dotGeo.attributes.position.needsUpdate = true;

      // Rebuild connection lines
      let li = 0;
      for (let i = 0; i < COUNT; i++) {
        for (let j = i + 1; j < COUNT; j++) {
          const ddx = pos[i*3] - pos[j*3];
          const ddy = pos[i*3+1] - pos[j*3+1];
          if (ddx*ddx + ddy*ddy < CONNECT_DIST * CONNECT_DIST) {
            lineBuf[li++] = pos[i*3];   lineBuf[li++] = pos[i*3+1]; lineBuf[li++] = 0;
            lineBuf[li++] = pos[j*3];   lineBuf[li++] = pos[j*3+1]; lineBuf[li++] = 0;
          }
        }
      }
      lineGeo.setDrawRange(0, li / 3);
      lineGeo.attributes.position.needsUpdate = true;

      renderer.render(scene, camera);
    }
    animate();

    // ── Resize ────────────────────────────────────────────────────────────────
    window.addEventListener('resize', () => {
      W = section.clientWidth;
      H = section.clientHeight;
      renderer.setSize(W, H);
      camera.left   = -W / 2; camera.right = W / 2;
      camera.top    =  H / 2; camera.bottom = -H / 2;
      camera.updateProjectionMatrix();
    }, { passive: true });
  }
</script>

<!-- Inject data for terminal commands -->
<script is:inline define:vars={{ _achData, _prjData }}>
  window.__ach = _achData;
  window.__prj = _prjData;
</script>

<!-- Interactive terminal logic -->
<script>
  // ── DOM refs ────────────────────────────────────────────────────────────────
  const bootBtn   = document.getElementById('boot-line-btn')  as HTMLElement | null;
  const terminal  = document.getElementById('hero-terminal')  as HTMLElement | null;
  const output    = document.getElementById('ht-output')      as HTMLElement | null;
  const input     = document.getElementById('ht-input')       as HTMLInputElement | null;
  const closeBtn  = document.getElementById('ht-close-btn')   as HTMLElement | null;
  const rightCol  = document.getElementById('hero-right-col') as HTMLElement | null;
  const logoEl    = document.getElementById('hero-logo-el')   as HTMLElement | null;

  if (!bootBtn || !terminal || !output || !input) throw new Error();

  let isOpen       = false;
  let isTyping     = false;
  let abortTyping  = false;
  let popupFromTab = false;
  const history: string[] = [];
  let histIdx = -1;

  const VALID_SECTIONS = ['about', 'experience', 'achievements', 'projects', 'contact'];

  // ── Helpers ──────────────────────────────────────────────────────────────────
  function addLine(html: string) {
    const div = document.createElement('div');
    div.className = 'ht-line';
    div.innerHTML = html;
    output!.appendChild(div);
    output!.scrollTop = output!.scrollHeight;
  }

  function addPrompt(cmd: string) {
    addLine(`<span class="tc-green">$</span> <span class="tc-fg">${escHtml(cmd)}</span>`);
  }

  function escHtml(s: string) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  async function printLines(lines: string[], delay = 32) {
    for (const l of lines) {
      if (abortTyping) break;
      addLine(l);
      output!.scrollTop = output!.scrollHeight;
      await new Promise(r => setTimeout(r, delay));
    }
  }

  async function animateProgress(label: string, steps = 20, stepMs = 60): Promise<void> {
    const div = document.createElement('div');
    div.className = 'ht-line';
    output!.appendChild(div);
    output!.scrollTop = output!.scrollHeight;
    for (let i = 0; i <= steps; i++) {
      if (abortTyping) break;
      const filled = '█'.repeat(i);
      const empty  = '░'.repeat(steps - i);
      const pct    = Math.round((i / steps) * 100);
      div.innerHTML = `  ${label} <span class="tc-green">${filled}</span><span class="tc-dim">${empty}</span>  ${pct}%`;
      output!.scrollTop = output!.scrollHeight;
      await new Promise(r => setTimeout(r, stepMs));
    }
  }

  // ── Commands ────────────────────────────────────────────────────────────────
  type Lines = string[];
  type CmdFn = () => Lines | Promise<Lines | void>;
  const COMMANDS: Record<string, CmdFn> = {
    help: () => [
      '',
      `  <span class="tc-green">Available commands:</span>`,
      `  <button class="ht-cmd-btn" data-cmd="whoami">whoami</button>           — who am I`,
      `  <button class="ht-cmd-btn" data-cmd="skills">skills</button>           — tech stack`,
      `  <button class="ht-cmd-btn" data-cmd="experience">experience</button>   — work history`,
      `  <button class="ht-cmd-btn" data-cmd="achievements">achievements</button> — awards & competitions`,
      `  <button class="ht-cmd-btn" data-cmd="projects">projects</button>       — project list`,
      `  <button class="ht-cmd-btn" data-cmd="cat bio.txt">cat bio.txt</button> — read my bio`,
      `  <button class="ht-cmd-btn" data-cmd="ls">ls</button>               — list sections`,
      `  <button class="ht-cmd-btn" data-cmd="pwd">pwd</button>              — current path`,
      `  <button class="ht-cmd-btn" data-cmd="date">date</button>             — current date/time`,
      `  <button class="ht-cmd-btn" data-cmd="uname -a">uname -a</button>      — system info`,
      `  <button class="ht-cmd-btn" data-cmd="open about">open</button> <span class="tc-dim">[section]</span>      — navigate to section`,
      `  <button class="ht-cmd-btn" data-cmd="contact">contact</button>         — scroll to contact`,
      `  <button class="ht-cmd-btn" data-cmd="cat cv.pdf">cat cv.pdf</button>   — download CV`,
      `  <button class="ht-cmd-btn" data-cmd="history">history</button>         — command history`,
      `  <button class="ht-cmd-btn" data-cmd="clear">clear</button>           — clear terminal  <span class="tc-dim">(Ctrl+L)</span>`,
      `  <button class="ht-cmd-btn" data-cmd="exit">exit</button>            — close terminal`,
      `  <span class="tc-dim">// psst: try "sudo hire me"</span>`,
      '',
    ],
    whoami: () => [
      '',
      `  <span class="tc-green">Arifin Yunianta</span>`,
      `  <span class="tc-dim">role      :</span> Backend Developer`,
      `  <span class="tc-dim">location  :</span> Indonesia`,
      `  <span class="tc-dim">stack     :</span> Go · PHP · Node.js`,
      `  <span class="tc-dim">status    :</span> <span class="tc-green">● Available for collaboration</span>`,
      '',
    ],
    skills: () => [
      '',
      `  <span class="tc-dim">Languages  :</span> <span class="tc-green">Go</span>, <span class="tc-cyan">PHP</span>, JavaScript`,
      `  <span class="tc-dim">Frameworks :</span> Laravel, Node.js, Flutter, React`,
      `  <span class="tc-dim">Databases  :</span> MySQL, PostgreSQL, Clickhouse, Firebase`,
      `  <span class="tc-dim">Tools      :</span> Git, Docker, Linux`,
      `  <span class="tc-cyan">Learning   :</span> Kubernetes, Rust`,
