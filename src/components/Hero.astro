    projects: () => {
      const data = ((window as any).__prj ?? []) as Array<{ title: string; tech: string[]; status: string }>;
      if (!data.length) return ['', `  <span class="tc-dim">// no projects yet — coming soon</span>`, `  <button class="ht-cmd-btn" data-cmd="open projects">→ open projects section</button>`, ''];
